@using System.Linq
@model HealthTrack.ViewModels.AdminAssignmentsVm
@{ ViewBag.Title = "Assignments"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<link rel="stylesheet" href="@Url.Content("~/Content/admin-management.css")" />
<section class="am-head"><div><small>TRAINER RELATIONSHIPS</small><h1>Client assignments</h1><p>Keep trainer relationships accurate and up to date.</p></div><span>@Model.Pending.Count pending</span></section>
@if (TempData["AdminError"] != null) { <div class="am-alert">@TempData["AdminError"]</div> }
@if (TempData["AdminNotice"] != null) { <div class="am-success">@TempData["AdminNotice"]</div> }
<div class="am-tabs"><button type="button" data-tab="pending" class="am-selected">Pending requests (@Model.Pending.Count)</button><button type="button" data-tab="unassigned">Unassigned (@Model.Clients.Count(x => !x.TrainerId.HasValue))</button><button type="button" data-tab="assigned">Assigned (@Model.Clients.Count(x => x.TrainerId.HasValue))</button></div>
<section data-panel="pending" class="am-table-wrap"><table class="am-table"><thead><tr><th>Client</th><th>Requested trainer</th><th>Requested</th><th>Action</th></tr></thead><tbody>@foreach (var r in Model.Pending) { <tr><td>@r.Client</td><td>@r.Trainer</td><td>@r.Created.ToString("dd MMM yyyy")</td><td>@using (Html.BeginForm("CancelSelection", "Admin", FormMethod.Post)) { @Html.AntiForgeryToken() <input type="hidden" name="requestId" value="@r.RequestId" /><button type="submit" class="am-outline" onclick="return confirm('Cancel this pending request?')">Cancel request</button> }</td></tr> }@if (!Model.Pending.Any()) { <tr><td colspan="4">No pending requests.</td></tr> }</tbody></table></section>
@foreach (var kind in new[] { "unassigned", "assigned" }) { <section data-panel="@kind" class="am-table-wrap" hidden><table class="am-table"><thead><tr><th>Client</th><th>Current trainer</th><th>Change assignment</th></tr></thead><tbody>@foreach (var row in Model.Clients.Where(x => kind == "assigned" ? x.TrainerId.HasValue : !x.TrainerId.HasValue)) { <tr><td><strong>@row.Client</strong></td><td>@row.Trainer</td><td>@using (Html.BeginForm("ChangeAssignment", "Admin", FormMethod.Post, new { @class = "am-assign-form" })) { @Html.AntiForgeryToken() <input type="hidden" name="clientId" value="@row.ClientId" /><select name="trainerId" aria-label="Choose trainer for @row.Client"><option value="">Unassigned</option>@foreach (var t in Model.Trainers) { <option value="@t.TrainerId" @(row.TrainerId == t.TrainerId ? "selected" : "")>@t.Name</option> }</select><button type="submit" onclick="return confirm('Save this assignment? Existing future appointments will be cancelled.')">Save</button> }</td></tr> }@if (!Model.Clients.Any(x => kind == "assigned" ? x.TrainerId.HasValue : !x.TrainerId.HasValue)) { <tr><td colspan="3">No clients in this group.</td></tr> }</tbody></table></section> }
<script>(function(){var tabs=document.querySelectorAll('[data-tab]');var panels=document.querySelectorAll('[data-panel]');Array.prototype.forEach.call(tabs,function(tab){tab.addEventListener('click',function(){Array.prototype.forEach.call(tabs,function(x){x.classList.toggle('am-selected',x===tab)});Array.prototype.forEach.call(panels,function(x){x.hidden=x.getAttribute('data-panel')!==tab.getAttribute('data-tab')})})});var initial=@Html.Raw(System.Web.Helpers.Json.Encode(Model.Tab));var selected=document.querySelector('[data-tab="'+initial+'"]');if(selected)selected.click();})();</script>
