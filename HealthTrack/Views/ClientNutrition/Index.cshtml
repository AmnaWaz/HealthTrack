
@model HealthTrack.ViewModels.ClientNutritionViewModel
@using System
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Nutrition";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var selectedLogs = Model.MealLogs
        .Where(m => m.Date.Date == Model.SelectedDate.Date)
        .ToList();

    var mealTypes = new[] { "Breakfast", "Lunch", "Dinner", "Snack" };
    var culture = CultureInfo.InvariantCulture;
}

<style>
    .cn-page {
        max-width: 1440px;
        margin: 0 auto;
        padding: 28px 14px 70px;
    }

    .cn-eyebrow {
        display: block;
        color: #b55762;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .cn-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 32px;
    }

        .cn-heading h1 {
            font: 700 clamp(42px, 5vw, 68px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin: 8px 0;
        }

        .cn-heading p,
        .cn-muted {
            color: #828995;
            font-size: 13px;
        }

    .cn-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        border: 1px solid #b6505d;
        background: #b6505d;
        color: #fff;
        border-radius: 0;
        text-decoration: none;
        text-transform: uppercase;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: .5px;
        cursor: pointer;
    }

        .cn-button:hover {
            background: #943e49;
            color: #fff;
        }

    .cn-button-outline {
        border-color: #949ba5;
        background: transparent;
        color: inherit;
    }

        .cn-button-outline:hover {
            border-color: #b6505d;
            background: transparent;
            color: #b6505d;
        }

    .cn-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        border: 1px solid var(--ht-border, #c8c6c2);
        background: var(--ht-border, #c8c6c2);
    }

    .cn-stat {
        background: var(--ht-surface, #f4f0e8);
        padding: 22px;
        min-width: 0;
    }

        .cn-stat span {
            display: block;
            margin-bottom: 14px;
            color: #868d98;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .cn-stat strong {
            font: 700 36px "Archivo Narrow", sans-serif;
        }

    .cn-section {
        margin-top: 42px;
    }

    .cn-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 20px;
    }

        .cn-section-heading h2 {
            font: 700 28px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin: 7px 0 0;
        }

    .cn-plan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 14px;
    }

    .cn-plan,
    .cn-panel {
        background: var(--ht-surface, #f4f0e8);
        border: 1px solid var(--ht-border, #b9bdc2);
        padding: 22px;
        min-width: 0;
    }

    .cn-plan-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .cn-plan h3 {
        font: 700 25px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        margin: 18px 0 12px;
    }

    .cn-plan p {
        color: #838b98;
        font-size: 13px;
        margin: 8px 0;
    }

    .cn-status {
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        color: #b6505d;
    }

    .cn-plan details {
        border-top: 1px solid var(--ht-border, #b9bdc2);
        padding-top: 17px;
        margin-top: 20px;
    }

    .cn-plan summary {
        cursor: pointer;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
    }

    .cn-plan-description {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 15px;
    }

    .cn-journal-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 350px;
        gap: 22px;
    }

    .cn-date-form {
        display: flex;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .cn-field {
        margin-bottom: 16px;
    }

        .cn-field label {
            display: block;
            margin-bottom: 8px;
            font: 600 11px "IBM Plex Mono", monospace;
            text-transform: uppercase;
        }

        .cn-field input,
        .cn-field select {
            display: block;
            width: 100%;
            min-width: 0;
            padding: 12px;
            border: 1px solid #aeb3ba;
            border-radius: 0;
            background: var(--ht-surface, #f4f0e8);
            color: inherit;
            font-size: 13px;
        }

    .cn-date-form .cn-field {
        margin: 0;
    }

    .cn-date-form input {
        max-width: 230px;
    }

    .cn-day-heading {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 16px;
        margin-bottom: 20px;
    }

        .cn-day-heading h3 {
            font: 700 24px "Archivo Narrow", sans-serif;
            margin: 0 0 8px;
            text-transform: uppercase;
        }

    .cn-day-total {
        text-align: right;
    }

        .cn-day-total strong {
            font: 700 25px "Archivo Narrow", sans-serif;
        }

        .cn-day-total span {
            display: block;
            color: #868d98;
            font-size: 11px;
        }

    .cn-meal-group {
        margin-top: 22px;
    }

        .cn-meal-group h4 {
            margin: 0 0 12px;
            font: 600 11px "IBM Plex Mono", monospace;
            color: #b6505d;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .cn-meal-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        border-top: 1px solid var(--ht-border, #b9bdc2);
        padding: 16px 0;
    }

        .cn-meal-row h5 {
            font: 700 19px "Archivo Narrow", sans-serif;
            margin: 0 0 6px;
        }

        .cn-meal-row p {
            color: #828995;
            font-size: 12px;
            margin: 4px 0;
        }

    .cn-meal-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-shrink: 0;
    }

    .cn-text-action {
        border: 0;
        background: transparent;
        color: #b6505d;
        text-transform: uppercase;
        font: 600 11px "IBM Plex Mono", monospace;
        cursor: pointer;
        padding: 5px 2px;
    }

        .cn-text-action:hover {
            text-decoration: underline;
        }

    .cn-form-title {
        font: 700 28px "Archivo Narrow", sans-serif;
        margin: 10px 0 22px;
        text-transform: uppercase;
    }

    .cn-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .cn-alert {
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .12);
        padding: 14px;
        margin-bottom: 25px;
        font-size: 13px;
    }

    .cn-validation {
        color: #bd4a58;
        font-size: 12px;
        margin: 5px 0;
    }

    .cn-empty {
        border: 1px dashed #aeb3ba;
        padding: 32px 18px;
        text-align: center;
    }

        .cn-empty h3 {
            font: 700 21px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

    .cn-history-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 15px 0;
        border-top: 1px solid var(--ht-border, #b9bdc2);
        font-size: 12px;
    }

        .cn-history-row strong {
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .cn-history-row span {
            color: #858c96;
        }

    .cn-hidden {
        display: none !important;
    }

    @@media (max-width: 1050px) {
        .cn-journal-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .cn-heading {
            flex-direction: column;
            align-items: stretch;
        }

        .cn-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cn-stat {
            padding: 16px;
        }

            .cn-stat strong {
                font-size: 29px;
            }

        .cn-plan-grid {
            grid-template-columns: 1fr;
        }

        .cn-day-heading {
            flex-direction: column;
        }

        .cn-day-total {
            text-align: left;
        }
    }
</style>

<div class="cn-page">
    <header class="cn-heading">
        <div>
            <span class="cn-eyebrow">03 / CLIENT WORKSPACE</span>
            <h1>YOUR NUTRITION</h1>
            <p>Follow your assigned diet plans and keep a record of what you eat.</p>
        </div>

        <button type="button" class="cn-button" id="cnJumpToLogger">
            + LOG A MEAL
        </button>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="cn-alert" role="status">
            @TempData["Success"]
        </div>
    }

    <div class="cn-stats">
        <div class="cn-stat">
            <span>Active diet plans</span>
            <strong>@Model.ActivePlanCount</strong>
        </div>

        <div class="cn-stat">
            <span>Logged meals</span>
            <strong>@Model.TotalMealEntries</strong>
        </div>

        <div class="cn-stat">
            <span>Days recorded</span>
            <strong>@Model.DaysWithMeals</strong>
        </div>

        <div class="cn-stat">
            <span>Selected day kcal</span>
            <strong>@Model.SelectedDayCalories.ToString("0.#")</strong>
        </div>
    </div>

    <section class="cn-section">
        <div class="cn-section-heading">
            <div>
                <span class="cn-eyebrow">01 / YOUR DIET</span>
                <h2>ASSIGNED DIET PLANS</h2>
            </div>
            <span class="cn-muted">@Model.ActivePlanCount active</span>
        </div>

        @if (Model.Plans.Any())
        {
            <div class="cn-plan-grid">
                @foreach (var plan in Model.Plans)
                {
                    <article class="cn-plan">
                        <div class="cn-plan-top">
                            <span class="cn-eyebrow">PLAN @plan.DietPlanId</span>
                            <span class="cn-status">@plan.Status</span>
                        </div>

                        <h3>@plan.PlanName</h3>

                        <p>Trainer: @plan.TrainerName</p>

                        <p>
                            @plan.StartDate.ToString("dd MMM yyyy")
                            —
                            @plan.EndDate.ToString("dd MMM yyyy")
                        </p>

                        <p>@plan.LoggedMeals meal entries linked to this plan</p>

                        <details>
                            <summary>View trainer instructions</summary>
                            <div class="cn-plan-description">
                                @(string.IsNullOrWhiteSpace(plan.Description)
                                ? "No additional instructions have been provided."
                                : plan.Description)
                            </div>
                        </details>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="cn-empty">
                <h3>NO DIET PLANS ASSIGNED</h3>
                <p class="cn-muted">
                    Your trainer's diet plans will appear here.
                    You can still log your meals.
                </p>
            </div>
        }
    </section>

    <section class="cn-section">
        <div class="cn-section-heading">
            <div>
                <span class="cn-eyebrow">02 / FOOD JOURNAL</span>
                <h2>DAILY MEAL RECORD</h2>
            </div>
        </div>

        <div class="cn-journal-layout">
            <div class="cn-panel">
                <form class="cn-date-form"
                      method="get"
                      action="@Url.Action("Index", "ClientNutrition")">
                    <div class="cn-field">
                        <label for="cnSelectedDate">Select date</label>
                        <input type="date"
                               id="cnSelectedDate"
                               name="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <button type="submit" class="cn-button cn-button-outline">
                        VIEW DAY
                    </button>
                </form>

                <div class="cn-day-heading">
                    <div>
                        <span class="cn-eyebrow">SELECTED DATE</span>
                        <h3>@Model.SelectedDate.ToString("dddd, dd MMMM yyyy")</h3>
                        <p class="cn-muted">@Model.SelectedDayMealCount meal entries</p>
                    </div>

                    <div class="cn-day-total">
                        <strong>@Model.SelectedDayCalories.ToString("0.#")</strong>
                        <span>RECORDED KCAL</span>
                    </div>
                </div>

                @if (selectedLogs.Any())
                {
                    foreach (var mealType in mealTypes)
                    {
                        var group = selectedLogs
                            .Where(m => m.MealType == mealType)
                            .ToList();

                        if (group.Any())
                        {
                            <div class="cn-meal-group">
                                <h4>@mealType</h4>

                                @foreach (var log in group)
                                {
                                    <article class="cn-meal-row">
                                        <div>
                                            <h5>@log.FoodItem</h5>
                                            <p>@log.PlanName</p>
                                            <p>@log.Calories.ToString("0.#") recorded kcal</p>
                                        </div>

                                        <div class="cn-meal-actions">
                                            <button type="button"
                                                    class="cn-text-action cn-edit-meal"
                                                    data-id="@log.MealLogId"
                                                    data-plan="@log.DietPlanId"
                                                    data-date="@log.Date.ToString("yyyy-MM-dd")"
                                                    data-type="@log.MealType"
                                                    data-food="@log.FoodItem"
                                                    data-calories="@log.Calories.ToString(culture)">
                                                EDIT
                                            </button>

                                            @using (Html.BeginForm("Delete", "ClientNutrition", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@log.MealLogId" />
                                                <button type="submit"
                                                        class="cn-text-action cn-delete-meal">
                                                    DELETE
                                                </button>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="cn-empty">
                        <h3>NO MEALS LOGGED</h3>
                        <p class="cn-muted">
                            Choose another date or add your first meal entry.
                        </p>
                    </div>
                }
            </div>

            <aside class="cn-panel" id="cnMealLogger">
                <span class="cn-eyebrow">NEW ENTRY</span>
                <h2 class="cn-form-title" id="cnFormTitle">LOG A MEAL</h2>

                @using (Html.BeginForm("Save", "ClientNutrition", FormMethod.Post, new { id = "cnMealForm" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="cnMealLogId"
                           name="MealLogId"
                           value="@Model.LogForm.MealLogId" />

                    @Html.ValidationSummary(false, "", new { @class = "cn-validation" })

                    <div class="cn-field">
                        <label for="cnMealDate">Date</label>
                        <input type="date"
                               id="cnMealDate"
                               name="Date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@(Model.LogForm.Date.HasValue ? Model.LogForm.Date.Value.ToString("yyyy-MM-dd") : "")"
                               required />
                        @Html.ValidationMessage("Date", new { @class = "cn-validation" })
                    </div>

                    <div class="cn-field">
                        <label for="cnDietPlan">Diet plan</label>
                        <select id="cnDietPlan" name="DietPlanId">
                            <option value="">Independent meal</option>

                            @foreach (var plan in Model.Plans)
                            {
                                <option value="@plan.DietPlanId"
                                        selected="@(Model.LogForm.DietPlanId == plan.DietPlanId ? "selected" : null)">
                                    @plan.PlanName
                                </option>
                            }
                        </select>
                        @Html.ValidationMessage("DietPlanId", new { @class = "cn-validation" })
                    </div>

                    <div class="cn-field">
                        <label for="cnMealType">Meal type</label>
                        <select id="cnMealType" name="MealType" required>
                            <option value="">Select a meal type</option>

                            @foreach (var mealType in mealTypes)
                            {
                                <option value="@mealType"
                                        selected="@(Model.LogForm.MealType == mealType ? "selected" : null)">
                                    @mealType
                                </option>
                            }
                        </select>
                        @Html.ValidationMessage("MealType", new { @class = "cn-validation" })
                    </div>

                    <div class="cn-field">
                        <label for="cnFoodItem">Food item</label>
                        <input type="text"
                               id="cnFoodItem"
                               name="FoodItem"
                               maxlength="150"
                               placeholder="e.g. Chicken rice"
                               value="@Model.LogForm.FoodItem"
                               required />
                        @Html.ValidationMessage("FoodItem", new { @class = "cn-validation" })
                    </div>

                    <div class="cn-field">
                        <label for="cnCalories">Calories (kcal)</label>
                        <input type="number"
                               id="cnCalories"
                               name="Calories"
                               min="0"
                               max="10000"
                               step="0.1"
                               value="@Model.LogForm.Calories.ToString(culture)"
                               required />
                        @Html.ValidationMessage("Calories", new { @class = "cn-validation" })
                    </div>

                    <p class="cn-muted">
                        Record the calories you know.
                        HealthTrack does not estimate nutrition values automatically.
                    </p>

                    <div class="cn-form-actions">
                        <button type="submit"
                                class="cn-button"
                                id="cnSaveMeal">
                            SAVE MEAL
                        </button>

                        <button type="button"
                                class="cn-button cn-button-outline cn-hidden"
                                id="cnCancelEdit">
                            CANCEL EDIT
                        </button>
                    </div>
                }
            </aside>
        </div>
    </section>

    <section class="cn-section">
        <div class="cn-section-heading">
            <div>
                <span class="cn-eyebrow">03 / HISTORY</span>
                <h2>COMPLETE MEAL HISTORY</h2>
            </div>
            <span class="cn-muted">@Model.TotalMealEntries entries</span>
        </div>

        @if (Model.MealLogs.Any())
        {
            <div class="cn-panel">
                @foreach (var log in Model.MealLogs)
                {
                    <div class="cn-history-row">
                        <div>
                            <strong>@log.FoodItem</strong>
                            <span>
                                @log.Date.ToString("dd MMM yyyy")
                                · @log.MealType
                                · @log.PlanName
                            </span>
                        </div>

                        <div>@log.Calories.ToString("0.#") kcal</div>

                        <a class="cn-text-action"
                           href="@Url.Action("Index", "ClientNutrition", new { date = log.Date.ToString("yyyy-MM-dd") })">
                            VIEW
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="cn-empty">
                <h3>YOUR FOOD JOURNAL IS EMPTY</h3>
                <p class="cn-muted">
                    Your saved meals will appear here.
                </p>
            </div>
        }
    </section>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var form = document.getElementById("cnMealForm");
            var logger = document.getElementById("cnMealLogger");
            var jumpButton = document.getElementById("cnJumpToLogger");
            var cancelButton = document.getElementById("cnCancelEdit");
            var saveButton = document.getElementById("cnSaveMeal");
            var title = document.getElementById("cnFormTitle");
            var selectedDate = document.getElementById("cnSelectedDate").value;

            function jumpToLogger() {
                logger.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }

            jumpButton.addEventListener("click", function () {
                jumpToLogger();
                document.getElementById("cnFoodItem").focus();
            });

            document.querySelectorAll(".cn-edit-meal").forEach(function (button) {
                button.addEventListener("click", function () {
                    document.getElementById("cnMealLogId").value = button.dataset.id;
                    document.getElementById("cnDietPlan").value = button.dataset.plan || "";
                    document.getElementById("cnMealDate").value = button.dataset.date;
                    document.getElementById("cnMealType").value = button.dataset.type;
                    document.getElementById("cnFoodItem").value = button.dataset.food;
                    document.getElementById("cnCalories").value = button.dataset.calories;

                    title.textContent = "EDIT MEAL";
                    saveButton.textContent = "SAVE CHANGES";
                    cancelButton.classList.remove("cn-hidden");

                    jumpToLogger();
                });
            });

            document.querySelectorAll(".cn-delete-meal").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    if (!window.confirm("Delete this meal entry?")) {
                        event.preventDefault();
                    }
                });
            });

            cancelButton.addEventListener("click", function () {
                form.reset();

                document.getElementById("cnMealLogId").value = "0";
                document.getElementById("cnMealDate").value = selectedDate;
                document.getElementById("cnDietPlan").value = "";
                document.getElementById("cnMealType").value = "";
                document.getElementById("cnFoodItem").value = "";
                document.getElementById("cnCalories").value = "0";

                title.textContent = "LOG A MEAL";
                saveButton.textContent = "SAVE MEAL";
                cancelButton.classList.add("cn-hidden");
            });
        });
    </script>
}
