
@model HealthTrack.ViewModels.ClientNotificationsViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<style>
    .cno-page {
        max-width: 1220px;
        margin: 0 auto;
        padding: 28px 14px 70px;
    }

    .cno-eyebrow {
        display: block;
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .cno-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 32px;
    }

        .cno-header h1 {
            margin: 8px 0;
            font: 700 clamp(40px, 5vw, 68px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cno-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .cno-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border: 1px solid #b6505d;
        background: #b6505d;
        color: #fff;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        cursor: pointer;
        text-decoration: none;
    }

        .cno-button:hover {
            background: #963f4a;
            color: #fff;
        }

    .cno-button-outline {
        background: transparent;
        border-color: #aeb3ba;
        color: inherit;
    }

        .cno-button-outline:hover {
            border-color: #b6505d;
            background: transparent;
            color: #b6505d;
        }

    .cno-button:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    .cno-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        background: #bfc1c5;
        border: 1px solid #bfc1c5;
        margin-bottom: 35px;
    }

    .cno-stat {
        background: var(--ht-surface, #f4f0e8);
        padding: 23px;
    }

        .cno-stat span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            margin-bottom: 13px;
        }

        .cno-stat strong {
            font: 700 36px "Archivo Narrow", sans-serif;
        }

    .cno-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .cno-tabs {
        display: inline-flex;
        border: 1px solid var(--ht-border, #b9bdc2);
    }

    .cno-tab {
        padding: 12px 20px;
        color: inherit;
        text-decoration: none;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
    }

        .cno-tab:hover {
            color: #b6505d;
        }

        .cno-tab.active {
            background: #17283d;
            color: #fff;
        }

    .cno-list {
        display: grid;
        gap: 12px;
    }

    .cno-card {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) auto;
        gap: 20px;
        padding: 23px;
        background: var(--ht-surface, #f4f0e8);
        border: 1px solid var(--ht-border, #b9bdc2);
        min-width: 0;
    }

    .cno-card-unread {
        border-left: 4px solid #b6505d;
    }

    .cno-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        background: #18293e;
        color: #fff;
        font: 700 17px "Archivo Narrow", sans-serif;
    }

    .cno-card-main {
        min-width: 0;
    }

    .cno-card-heading {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 10px;
    }

    .cno-type {
        font: 700 20px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
    }

    .cno-unread-label {
        background: rgba(182, 80, 93, .12);
        color: #b6505d;
        padding: 4px 7px;
        font: 600 10px "IBM Plex Mono", monospace;
    }

    .cno-message {
        font-size: 14px;
        line-height: 1.8;
        margin: 0 0 15px;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .cno-time {
        color: #858d99;
        font: 500 11px "IBM Plex Mono", monospace;
    }

    .cno-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .cno-link {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
    }

        .cno-link:hover {
            text-decoration: underline;
        }

    .cno-text-button {
        border: 0;
        background: transparent;
        color: #b6505d;
        padding: 0;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        cursor: pointer;
        white-space: nowrap;
    }

        .cno-text-button:hover {
            text-decoration: underline;
        }

    .cno-empty {
        padding: 55px 25px;
        text-align: center;
        border: 1px dashed #aeb3ba;
    }

        .cno-empty h2 {
            font: 700 28px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .cno-empty p {
            max-width: 460px;
            margin: 0 auto;
        }

    .cno-footer-note {
        margin-top: 20px;
        font-size: 12px;
        color: #858d99;
    }

    @@media (max-width: 800px) {
        .cno-card {
            grid-template-columns: 42px minmax(0, 1fr);
        }

        .cno-actions {
            grid-column: 2;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 580px) {
        .cno-header {
            flex-direction: column;
            align-items: stretch;
        }

        .cno-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .cno-stat {
            padding: 14px;
        }

            .cno-stat strong {
                font-size: 28px;
            }

        .cno-card {
            padding: 15px;
            gap: 13px;
        }

        .cno-toolbar {
            align-items: stretch;
        }

        .cno-tabs {
            width: 100%;
        }

        .cno-tab {
            flex: 1;
            text-align: center;
        }
    }
</style>

<div class="cno-page">
    <header class="cno-header">
        <div>
            <span class="cno-eyebrow">07 / CLIENT WORKSPACE</span>
            <h1>NOTIFICATIONS</h1>
            <p class="cno-muted">
                Appointment updates, trainer feedback and important activity.
            </p>
        </div>
    </header>

    <div class="cno-stats">
        <div class="cno-stat">
            <span>Total notifications</span>
            <strong>@Model.TotalCount</strong>
        </div>

        <div class="cno-stat">
            <span>Unread</span>
            <strong>@Model.UnreadCount</strong>
        </div>

        <div class="cno-stat">
            <span>Read</span>
            <strong>@Model.ReadCount</strong>
        </div>
    </div>

    <div class="cno-toolbar">
        <nav class="cno-tabs" aria-label="Notification filters">
            <a class="cno-tab @(Model.Filter == "all" ? "active" : "")"
               href="@Url.Action("Index", "ClientNotifications", new { filter = "all" })"
               aria-current="@(Model.Filter == "all" ? "page" : null)">
                ALL (@Model.TotalCount)
            </a>

            <a class="cno-tab @(Model.Filter == "unread" ? "active" : "")"
               href="@Url.Action("Index", "ClientNotifications", new { filter = "unread" })"
               aria-current="@(Model.Filter == "unread" ? "page" : null)">
                UNREAD (@Model.UnreadCount)
            </a>
        </nav>

        @using (Html.BeginForm("MarkAllRead", "ClientNotifications", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="filter" value="@Model.Filter" />

            <button type="submit"
                    class="cno-button cno-button-outline"
                    disabled="@(Model.UnreadCount == 0 ? "disabled" : null)">
                MARK ALL AS READ
            </button>
        }
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="cno-list">
            @foreach (var notification in Model.Notifications)
            {
                var typeName = string.IsNullOrWhiteSpace(notification.Type)
                    ? "General"
                    : notification.Type;

                var iconLetter = typeName.Substring(0, 1).ToUpperInvariant();

                <article class="cno-card @(!notification.IsRead ? "cno-card-unread" : "")">
                    <div class="cno-icon" aria-hidden="true">
                        @iconLetter
                    </div>

                    <div class="cno-card-main">
                        <div class="cno-card-heading">
                            <strong class="cno-type">@typeName</strong>

                            @if (!notification.IsRead)
                            {
                                <span class="cno-unread-label">
                                    NEW
                                </span>
                            }
                        </div>

                        <p class="cno-message">@notification.Message</p>

                        <time class="cno-time"
                              datetime="@notification.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")">
                            @notification.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")
                        </time>
                    </div>

                    <div class="cno-actions">
                        <a class="cno-link"
                           href="@Url.Action(notification.RelatedAction, notification.RelatedController)">
                            VIEW @notification.RelatedPageName →
                        </a>

                        @if (!notification.IsRead)
                        {
                            using (Html.BeginForm("MarkRead", "ClientNotifications", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notification.NotificationId" />
                                <input type="hidden" name="filter" value="@Model.Filter" />

                                <button type="submit" class="cno-text-button">
                                    MARK READ
                                </button>
                            }
                        }
                    </div>
                </article>
            }
        </div>

        if (Model.TotalCount > Model.Notifications.Count && Model.Filter == "all")
        {
            <p class="cno-footer-note">
                Showing the latest @Model.Notifications.Count of @Model.TotalCount notifications.
            </p>
        }
    }
    else
    {
        <div class="cno-empty">
            @if (Model.Filter == "unread")
            {
                <h2>YOU'RE ALL CAUGHT UP</h2>
                <p class="cno-muted">
                    You don't have any unread notifications.
                </p>
            }
            else
            {
                <h2>NO NOTIFICATIONS YET</h2>
                <p class="cno-muted">
                    Notifications from your trainer and appointment updates
                    will appear here.
                </p>
            }
        </div>
    }
</div>
