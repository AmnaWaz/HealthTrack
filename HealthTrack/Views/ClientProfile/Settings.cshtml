@model HealthTrack.ViewModels.ClientSettingsViewModel
@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
<link href="@Url.Content("~/Content/profile.css")" rel="stylesheet" />
<style>
    .ht-settings-account { padding-top: 18px; border-top: 1px solid var(--ht-border); margin-top: 8px; }
    .ht-settings-account dl { display: grid; grid-template-columns: 1fr; gap: 10px; margin: 0 0 20px; }
    .ht-settings-account dt { font: 500 11px var(--ht-font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ht-text-muted); }
    .ht-settings-account dd { margin: 2px 0 0; color: var(--ht-text); overflow-wrap: anywhere; }
    .ht-settings-error { color: #b6505d; font-size: 12px; }
</style>
<div class="ht-page">
    <div class="ht-page-head">
        <div>
            <p class="ht-eyebrow">Client / Settings</p>
            <h1 class="ht-h1">Your<br />settings.</h1>
            <p class="ht-sub">Appearance, workspace preferences and account security.</p>
        </div>
    </div>
    <div class="ht-tabs">
        @Html.ActionLink("Profile", "Index", "ClientProfile", null, new { @class = "ht-tab" })
        @Html.ActionLink("Settings", "Settings", "ClientProfile", null, new { @class = "ht-tab active", aria_current = "page" })
    </div>
    @if (TempData["Success"] != null) { <div class="ht-alert ok" role="status">@TempData["Success"]</div> }
    <div class="ht-grid-2">
        <section class="ht-card">
            <div class="ht-card-head"><h2 class="ht-card-title">Preferences</h2></div>
            <div class="ht-setting-row">
                <div>
                    <p class="ht-setting-title">Appearance</p>
                    <p class="ht-setting-sub">Choose the cream or navy workspace theme.</p>
                </div>
                <div class="ht-seg" role="group" aria-label="Display theme">
                    <button type="button" data-set-theme="light">Light</button>
                    <button type="button" data-set-theme="dark">Dark</button>
                </div>
            </div>
            <div class="ht-setting-row">
                <div>
                    <p class="ht-setting-title">Collapsed sidebar</p>
                    <p class="ht-setting-sub">Keep the navigation compact on desktop.</p>
                </div>
                <label class="ht-switch" title="Start with collapsed sidebar">
                    <input type="checkbox" id="sidebarPref" aria-label="Collapsed sidebar preference" />
                    <span></span>
                </label>
            </div>
            <div class="ht-settings-account">
                <p class="ht-setting-title">Account details</p>
                <dl>
                    <div><dt>Name</dt><dd>@Model.FullName</dd></div>
                    <div><dt>Email</dt><dd>@Model.Email</dd></div>
                </dl>
                @Html.ActionLink("Edit profile →", "Index", "ClientProfile", null, new { @class = "ht-btn" })
            </div>
        </section>
        <section class="ht-card">
            <div class="ht-card-head"><h2 class="ht-card-title">Account security</h2></div>
            @using (Html.BeginForm("ChangePassword", "ClientProfile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "ht-settings-error" })
                <div class="mb-4">
                    <label for="htCurrentPassword" class="form-label">Current password</label>
                    <input id="htCurrentPassword" name="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required />
                    @Html.ValidationMessage("CurrentPassword", new { @class = "ht-settings-error" })
                </div>
                <div class="mb-4">
                    <label for="htNewPassword" class="form-label">New password</label>
                    <input id="htNewPassword" name="NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" required />
                    @Html.ValidationMessage("NewPassword", new { @class = "ht-settings-error" })
                </div>
                <div class="mb-4">
                    <label for="htConfirmPassword" class="form-label">Confirm new password</label>
                    <input id="htConfirmPassword" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="100" required />
                    @Html.ValidationMessage("ConfirmPassword", new { @class = "ht-settings-error" })
                </div>
                <button type="submit" class="ht-btn">Update password</button>
            }
        </section>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-set-theme]'));
            function markTheme() {
                var theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
                buttons.forEach(function (button) {
                    var selected = button.getAttribute('data-set-theme') === theme;
                    button.classList.toggle('active', selected);
                    button.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });
            }
            buttons.forEach(function (button) {
                button.addEventListener('click', function () {
                    if (window.HealthTheme && typeof window.HealthTheme.set === 'function') {
                        window.HealthTheme.set(button.getAttribute('data-set-theme'));
                    }
                    markTheme();
                });
            });
            document.addEventListener('ht-theme-change', markTheme);
            markTheme();

            var preference = document.getElementById('sidebarPref');
            if (!preference) return;
            try { preference.checked = localStorage.getItem('ht-sidebar-collapsed') === '1'; } catch (e) { }
            preference.addEventListener('change', function () {
                try { localStorage.setItem('ht-sidebar-collapsed', preference.checked ? '1' : '0'); } catch (e) { }
                var shell = document.getElementById('htTrainerShell');
                if (shell && !window.matchMedia('(max-width: 767.98px)').matches) {
                    shell.classList.toggle('sidebar-collapsed', preference.checked);
                }
            });
        })();
    </script>
}
