
@model HealthTrack.ViewModels.ClientSettingsViewModel

@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<style>
    .cset-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 30px 16px 70px;
    }

    .cset-eyebrow {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .cset-page h1 {
        margin: 10px 0;
        font: 700 clamp(42px, 5vw, 65px) "Archivo Narrow", sans-serif;
        text-transform: uppercase;
    }

    .cset-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .cset-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        margin-top: 32px;
    }

    .cset-panel {
        padding: 25px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
    }

        .cset-panel h2 {
            margin: 8px 0 20px;
            font: 700 27px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cset-field {
        margin-bottom: 18px;
    }

        .cset-field label {
            display: block;
            margin-bottom: 8px;
            font: 600 11px "IBM Plex Mono", monospace;
            text-transform: uppercase;
        }

        .cset-field input {
            width: 100%;
            padding: 12px;
            border: 1px solid #aeb3ba;
            background: transparent;
            color: inherit;
            border-radius: 0;
            font-size: 13px;
        }

    .cset-button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 12px 18px;
        background: #b6505d;
        border: 1px solid #b6505d;
        color: #fff;
        font: 600 11px "IBM Plex Mono", monospace;
        text-decoration: none;
        cursor: pointer;
        text-transform: uppercase;
    }

        .cset-button:hover {
            background: #933e49;
            color: #fff;
        }

    .cset-button-outline {
        background: transparent;
        border-color: #aeb3ba;
        color: inherit;
    }

        .cset-button-outline:hover {
            background: transparent;
            border-color: #b6505d;
            color: #b6505d;
        }

    .cset-alert {
        padding: 14px;
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .12);
        margin-bottom: 22px;
    }

    .cset-validation {
        color: #b6505d;
        font-size: 12px;
    }

    .cset-account {
        padding: 15px 0;
        border-top: 1px solid var(--ht-border, #b9bdc2);
    }

        .cset-account span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            margin-bottom: 9px;
            text-transform: uppercase;
        }

        .cset-account strong {
            overflow-wrap: anywhere;
        }

    @@media (max-width: 800px) {
        .cset-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cset-page">
    <header>
        <span class="cset-eyebrow">ACCOUNT / PREFERENCES</span>
        <h1>SETTINGS</h1>
        <p class="cset-muted">
            Manage your account security and display preferences.
        </p>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="cset-alert" role="status">
            @TempData["Success"]
        </div>
    }

    <div class="cset-grid">
        <section class="cset-panel">
            <span class="cset-eyebrow">01 / ACCOUNT</span>
            <h2>YOUR ACCOUNT</h2>

            <div class="cset-account">
                <span>Name</span>
                <strong>@Model.FullName</strong>
            </div>

            <div class="cset-account">
                <span>Email</span>
                <strong>@Model.Email</strong>
            </div>

            <a class="cset-button cset-button-outline"
               href="@Url.Action("Index", "ClientProfile")">
                EDIT PERSONAL DETAILS
            </a>

            <div style="margin-top:35px">
                <span class="cset-eyebrow">02 / APPEARANCE</span>
                <h2>DISPLAY THEME</h2>

                <p class="cset-muted">
                    Change between light and dark mode using the theme
                    control in the top-right corner of HealthTrack.
                </p>

                <button type="button"
                        class="cset-button cset-button-outline"
                        data-theme-toggle>
                    SWITCH THEME
                </button>
            </div>
        </section>

        <section class="cset-panel">
            <span class="cset-eyebrow">03 / SECURITY</span>
            <h2>CHANGE PASSWORD</h2>

            @using (Html.BeginForm("ChangePassword", "ClientProfile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "cset-validation" })

                <div class="cset-field">
                    <label for="csetCurrentPassword">Current password</label>
                    <input type="password"
                           id="csetCurrentPassword"
                           name="CurrentPassword"
                           autocomplete="current-password"
                           required />
                    @Html.ValidationMessage("CurrentPassword", new { @class = "cset-validation" })
                </div>

                <div class="cset-field">
                    <label for="csetNewPassword">New password</label>
                    <input type="password"
                           id="csetNewPassword"
                           name="NewPassword"
                           autocomplete="new-password"
                           minlength="8"
                           maxlength="100"
                           required />
                    @Html.ValidationMessage("NewPassword", new { @class = "cset-validation" })
                </div>

                <div class="cset-field">
                    <label for="csetConfirmPassword">Confirm new password</label>
                    <input type="password"
                           id="csetConfirmPassword"
                           name="ConfirmPassword"
                           autocomplete="new-password"
                           minlength="8"
                           maxlength="100"
                           required />
                    @Html.ValidationMessage("ConfirmPassword", new { @class = "cset-validation" })
                </div>

                <p class="cset-muted">
                    Use a unique password with at least eight characters.
                </p>

                <button type="submit" class="cset-button">
                    UPDATE PASSWORD
                </button>
            }
        </section>
    </div>
</div>
