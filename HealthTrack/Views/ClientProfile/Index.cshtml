
@model HealthTrack.ViewModels.ClientProfileViewModel
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<style>
    .cpf-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 30px 16px 70px;
    }

    .cpf-eyebrow {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .cpf-title {
        margin: 10px 0;
        font: 700 clamp(42px, 5vw, 65px) "Archivo Narrow", sans-serif;
        text-transform: uppercase;
    }

    .cpf-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .cpf-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 30px;
    }

    .cpf-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 370px;
        gap: 20px;
    }

    .cpf-panel {
        padding: 25px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
        min-width: 0;
    }

        .cpf-panel h2 {
            margin: 7px 0 22px;
            font: 700 27px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cpf-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        background: #17283d;
        color: #fff;
        font: 700 35px "Archivo Narrow", sans-serif;
        margin-bottom: 18px;
    }

    .cpf-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .cpf-detail {
        padding-top: 15px;
        border-top: 1px solid var(--ht-border, #b9bdc2);
        min-width: 0;
    }

        .cpf-detail span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            margin-bottom: 9px;
        }

        .cpf-detail strong {
            display: block;
            font-size: 14px;
            overflow-wrap: anywhere;
        }

    .cpf-field {
        margin-bottom: 18px;
    }

        .cpf-field label {
            display: block;
            margin-bottom: 8px;
            font: 600 11px "IBM Plex Mono", monospace;
            text-transform: uppercase;
        }

        .cpf-field input {
            width: 100%;
            padding: 12px;
            border: 1px solid #aeb3ba;
            background: transparent;
            color: inherit;
            border-radius: 0;
            font-size: 13px;
        }

    .cpf-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        background: #b6505d;
        border: 1px solid #b6505d;
        color: #fff;
        text-decoration: none;
        text-transform: uppercase;
        font: 600 11px "IBM Plex Mono", monospace;
        cursor: pointer;
    }

        .cpf-button:hover {
            background: #933e49;
            color: #fff;
        }

    .cpf-button-outline {
        background: transparent;
        color: inherit;
        border-color: #aeb3ba;
    }

        .cpf-button-outline:hover {
            background: transparent;
            border-color: #b6505d;
            color: #b6505d;
        }

    .cpf-goals {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .cpf-goal {
        padding: 10px 13px;
        border: 1px solid var(--ht-border, #b9bdc2);
        font: 600 11px "IBM Plex Mono", monospace;
    }

    .cpf-alert {
        padding: 14px;
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .12);
        margin-bottom: 25px;
        font-size: 13px;
    }

    .cpf-validation {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #b6505d;
    }

    .cpf-section {
        margin-top: 22px;
    }

        .cpf-section h2 {
            font: 700 27px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin: 7px 0 20px;
        }

    @@media (max-width: 950px) {
        .cpf-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 580px) {
        .cpf-header {
            flex-direction: column;
            align-items: stretch;
        }

        .cpf-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cpf-page">
    <header class="cpf-header">
        <div>
            <span class="cpf-eyebrow">ACCOUNT / PROFILE</span>
            <h1 class="cpf-title">MY PROFILE</h1>
            <p class="cpf-muted">
                Your personal information, fitness goals and health profile.
            </p>
        </div>

        <a class="cpf-button cpf-button-outline"
           href="@Url.Action("Settings", "ClientProfile")">
            ACCOUNT SETTINGS
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="cpf-alert" role="status">
            @TempData["Success"]
        </div>
    }

    <div class="cpf-grid">
        <section class="cpf-panel">
            <div class="cpf-avatar" aria-hidden="true">
                @(string.IsNullOrWhiteSpace(Model.FirstName)
                    ? "C"
                    : Model.FirstName.Substring(0, 1).ToUpperInvariant())
            </div>

            <span class="cpf-eyebrow">PERSONAL DETAILS</span>
            <h2>@Model.FullName</h2>

            <div class="cpf-details">
                <div class="cpf-detail">
                    <span>Email address</span>
                    <strong>@Model.Email</strong>
                </div>

                <div class="cpf-detail">
                    <span>Phone number</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</strong>
                </div>

                <div class="cpf-detail">
                    <span>Date of birth</span>
                    <strong>@Model.DateOfBirth.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="cpf-detail">
                    <span>Gender</span>
                    <strong>@Model.Gender</strong>
                </div>

                <div class="cpf-detail">
                    <span>Height</span>
                    <strong>@Model.Height.ToString("0.##") cm</strong>
                </div>

                <div class="cpf-detail">
                    <span>Current weight</span>
                    <strong>@Model.Weight.ToString("0.##") kg</strong>
                </div>

                <div class="cpf-detail">
                    <span>Member since</span>
                    <strong>@Model.DateJoined.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="cpf-detail">
                    <span>Assigned trainer</span>
                    <strong>
                        @(Model.HasAssignedTrainer && !string.IsNullOrWhiteSpace(Model.TrainerName)
                            ? Model.TrainerName
                            : "Not assigned")
                    </strong>
                </div>
            </div>

            <div style="margin-top:25px">
                <a class="cpf-button cpf-button-outline"
                   href="@Url.Action("Index", "ClientProgress")">
                    VIEW HEALTH PROGRESS
                </a>
            </div>
        </section>

        <aside class="cpf-panel">
            <span class="cpf-eyebrow">EDIT ACCOUNT</span>
            <h2>UPDATE DETAILS</h2>

            @using (Html.BeginForm("SaveProfile", "ClientProfile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "cpf-validation" })

                <div class="cpf-field">
                    <label for="cpfFirstName">First name</label>
                    <input type="text"
                           id="cpfFirstName"
                           name="FirstName"
                           maxlength="50"
                           value="@Model.EditForm.FirstName"
                           required />
                    @Html.ValidationMessage("FirstName", new { @class = "cpf-validation" })
                </div>

                <div class="cpf-field">
                    <label for="cpfLastName">Last name</label>
                    <input type="text"
                           id="cpfLastName"
                           name="LastName"
                           maxlength="50"
                           value="@Model.EditForm.LastName"
                           required />
                    @Html.ValidationMessage("LastName", new { @class = "cpf-validation" })
                </div>

                <div class="cpf-field">
                    <label for="cpfPhone">Phone</label>
                    <input type="tel"
                           id="cpfPhone"
                           name="Phone"
                           maxlength="20"
                           value="@Model.EditForm.Phone" />
                    @Html.ValidationMessage("Phone", new { @class = "cpf-validation" })
                </div>

                <div class="cpf-field">
                    <label for="cpfHeight">Height (cm)</label>
                    <input type="number"
                           id="cpfHeight"
                           name="Height"
                           min="50"
                           max="260"
                           step="0.01"
                           value="@Model.EditForm.Height.ToString(CultureInfo.InvariantCulture)"
                           required />
                    @Html.ValidationMessage("Height", new { @class = "cpf-validation" })
                </div>

                <p class="cpf-muted">
                    Weight is updated by logging measurements in Progress.
                    Changing height recalculates BMI values.
                </p>

                <button type="submit" class="cpf-button">
                    SAVE PROFILE
                </button>
            }
        </aside>
    </div>

    <section class="cpf-section cpf-panel">
        <span class="cpf-eyebrow">YOUR OBJECTIVES</span>
        <h2>FITNESS GOALS</h2>

        @if (Model.FitnessGoals.Any())
        {
            <div class="cpf-goals">
                @foreach (var goal in Model.FitnessGoals)
                {
                    <span class="cpf-goal">@goal.Name</span>
                }
            </div>
        }
        else
        {
            <p class="cpf-muted">
                No fitness goals have been selected.
            </p>
        }

        <p class="cpf-muted" style="margin-top:18px">
            Your selected goals are displayed from your registration profile.
        </p>
    </section>
</div>
