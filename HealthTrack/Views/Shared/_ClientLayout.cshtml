
@{
    string ctrl = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    string act = Convert.ToString(ViewContext.RouteData.Values["action"]);
    string sideName = (ViewBag.SideName as string) ?? User.Identity.Name;
    string sideInitials = (ViewBag.SideInitials as string)
        ?? (string.IsNullOrWhiteSpace(sideName) ? "C" : sideName.Substring(0, 1).ToUpperInvariant());
    int unreadCount = ViewBag.SideUnread == null ? 0 : Convert.ToInt32(ViewBag.SideUnread);
}

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HealthTrack</title>

    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/favicon.svg")" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&amp;family=Archivo:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Source+Serif+4:ital,wght@0,400;0,500;1,400&amp;display=swap"
          rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Html.Partial("_ThemeHead")

    <link href="@Url.Content("~/Content/brand.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/sidebar.css")" rel="stylesheet" />

    @Scripts.Render("~/bundles/modernizr")

    <style>
        .ht-client-unread {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            margin-left: auto;
            border-radius: 3px;
            background: #b6505d;
            color: #ffffff;
            font: 600 10px "IBM Plex Mono", monospace;
        }

        .ht-sidebar-nav .ht-side-link {
            text-decoration: none;
        }

            .ht-sidebar-nav .ht-side-link:focus-visible {
                outline: 2px solid #b6505d;
                outline-offset: -2px;
            }

        .ht-client-account-links {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            padding: 12px 8px;
            border-top: 1px solid rgba(180, 190, 205, .2);
        }

            .ht-client-account-links a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                padding: 7px 11px;
                border: 1px solid rgba(180, 190, 205, .3);
                border-radius: 2px;
                color: inherit;
                text-decoration: none;
                font: 500 11px "IBM Plex Mono", monospace;
            }

                .ht-client-account-links a:hover,
                .ht-client-account-links a:focus-visible,
                .ht-client-account-links a.active {
                    color: #e18a94;
                    border-color: #b6505d;
                }

                .ht-client-account-links a:focus-visible {
                    outline: 2px solid #b6505d;
                    outline-offset: 2px;
                }

        .ht-trainer-shell.sidebar-collapsed .ht-client-account-links {
            display: none;
        }

        .ht-client-account-links a.active {
            font-weight: 600;
        }

        .ht-client-logout-form {
            margin: 0;
        }

        @@media (max-width: 767px) {
            .ht-client-account-links {
                padding: 12px 8px;
            }
        }
    </style>
</head>

<body>
    <div class="ht-trainer-shell" id="htTrainerShell">
        <script>
            (function () {
                try {
                    var state = localStorage.getItem("ht-sidebar-collapsed");
                    var tablet = window.matchMedia("(min-width: 768px) and (max-width: 1099.98px)").matches;

                    if (state === "1" || (state === null && tablet)) {
                        document.getElementById("htTrainerShell").classList.add("sidebar-collapsed");
                    }
                } catch (e) { }
            })();
        </script>

        <aside class="ht-sidebar" id="htSidebar">
            <div class="ht-sidebar-brand">
                <a class="ht-brand"
                   href="@Url.Action("Overview", "Client")"
                   aria-label="HealthTrack Client Overview">
                    @Html.Partial("_Brand")
                </a>
            </div>

            <div class="ht-sidebar-section-label">
                CLIENT / WORKSPACE
            </div>

            <nav class="ht-sidebar-nav" aria-label="Client navigation">
                <a class="ht-side-link @(ctrl == "Client" && act == "Overview" ? "active" : "")"
                   href="@Url.Action("Overview", "Client")"
                   title="Overview"
                   aria-current="@(ctrl == "Client" && act == "Overview" ? "page" : null)">
                    <span class="ht-side-num">01</span>
                    <span class="ht-side-label">Overview</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientTraining" ? "active" : "")"
                   href="@Url.Action("Index", "ClientTraining")"
                   title="Training"
                   aria-current="@(ctrl == "ClientTraining" ? "page" : null)">
                    <span class="ht-side-num">02</span>
                    <span class="ht-side-label">Training</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientNutrition" ? "active" : "")"
                   href="@Url.Action("Index", "ClientNutrition")"
                   title="Nutrition"
                   aria-current="@(ctrl == "ClientNutrition" ? "page" : null)">
                    <span class="ht-side-num">03</span>
                    <span class="ht-side-label">Nutrition</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientProgress" ? "active" : "")"
                   href="@Url.Action("Index", "ClientProgress")"
                   title="Progress"
                   aria-current="@(ctrl == "ClientProgress" ? "page" : null)">
                    <span class="ht-side-num">04</span>
                    <span class="ht-side-label">Progress</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientSessions" ? "active" : "")"
                   href="@Url.Action("Index", "ClientSessions")"
                   title="Sessions"
                   aria-current="@(ctrl == "ClientSessions" ? "page" : null)">
                    <span class="ht-side-num">05</span>
                    <span class="ht-side-label">Sessions</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientTrainer" ? "active" : "")"
                   href="@Url.Action("Index", "ClientTrainer")"
                   title="My Trainer"
                   aria-current="@(ctrl == "ClientTrainer" ? "page" : null)">
                    <span class="ht-side-num">06</span>
                    <span class="ht-side-label">My Trainer</span>
                </a>

                <a class="ht-side-link @(ctrl == "ClientNotifications" ? "active" : "")"
                   href="@Url.Action("Index", "ClientNotifications")"
                   title="Notifications"
                   aria-current="@(ctrl == "ClientNotifications" ? "page" : null)">
                    <span class="ht-side-num">07</span>
                    <span class="ht-side-label">Notifications</span>

                    @if (unreadCount > 0)
                    {
                        <span class="ht-client-unread"
                              aria-label="@unreadCount unread notifications">
                            @(unreadCount > 99 ? "99+" : unreadCount.ToString())
                        </span>
                    }
                </a>
            </nav>

            <div class="ht-sidebar-bottom">
                <div class="ht-sidebar-profile">
                    <span class="ht-profile-avatar" aria-hidden="true">
                        @sideInitials
                    </span>

                    <span class="ht-profile-info">
                        <strong>@sideName</strong>
                        <small>Client</small>
                    </span>
                </div>

                <nav class="ht-client-account-links"
                     aria-label="Client account">
                    <a href="@Url.Action("Index", "ClientProfile")"
                       class="@(ctrl == "ClientProfile" && act == "Index" ? "active" : "")"
                       aria-current="@(ctrl == "ClientProfile" && act == "Index" ? "page" : null)">
                        Profile
                    </a>

                    <a href="@Url.Action("Settings", "ClientProfile")"
                       class="@(ctrl == "ClientProfile" && act == "Settings" ? "active" : "")"
                       aria-current="@(ctrl == "ClientProfile" && act == "Settings" ? "page" : null)">
                        Settings
                    </a>
                </nav>

                <button type="button"
                        class="ht-sidebar-collapse"
                        id="htSidebarCollapse"
                        aria-label="Collapse sidebar"
                        title="Collapse sidebar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    <span>Collapse</span>
                </button>
            </div>
        </aside>

        <div class="ht-sidebar-overlay" id="htSidebarOverlay"></div>

        <div class="ht-trainer-main">
            <header class="ht-trainer-topbar">
                <button type="button"
                        class="ht-mobile-menu"
                        id="htMobileMenu"
                        aria-label="Open navigation"
                        aria-expanded="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <div class="ht-topbar-spacer"></div>

                <button type="button"
                        class="ht-theme-toggle"
                        data-theme-toggle
                        aria-label="Switch light / dark theme"
                        title="Switch light / dark theme">
                    <svg class="i-sun" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>

                    <svg class="i-moon" viewBox="0 0 24 24">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
                    </svg>
                </button>

                <span class="ht-topbar-user">@sideName</span>

                @using (Html.BeginForm(
                    "Logout",
                    "Account",
                    new { area = "" },
                    FormMethod.Post,
                    new { @class = "ht-logout-form ht-client-logout-form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ht-logout-button">
                        Logout
                    </button>
                }
            </header>

            <main class="ht-trainer-content">
                @RenderBody()

                <footer class="ht-trainer-footer">
                    <p>
                        &copy; @DateTime.Now.Year
                        &mdash;
                        <span class="footer-brand">HealthTrack</span>
                    </p>
                </footer>
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Html.Partial("_ThemeScripts")

    <script src="@Url.Content("~/Scripts/sidebar.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
