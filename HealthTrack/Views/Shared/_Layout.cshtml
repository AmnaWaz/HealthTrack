<!DOCTYPE html>
<html lang="en" data-theme="dark" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HealthTrack</title>

    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/favicon.svg")" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Html.Partial("_ThemeHead")
    <link href="@Url.Content("~/Content/brand.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/sidebar.css")" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        bool isTrainer = Request.IsAuthenticated && User.IsInRole("Trainer");
        string ctrl = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        string act = Convert.ToString(ViewContext.RouteData.Values["action"]);

        string sideName = (ViewBag.SideName as string) ?? User.Identity.Name;
        string sideInitials = (ViewBag.SideInitials as string)
            ?? (string.IsNullOrEmpty(sideName) ? "T" : sideName.Substring(0, 1).ToUpper());
        int unread = ViewBag.SideUnread is int ? (int)ViewBag.SideUnread : 0;
    }

    @if (isTrainer)
    {
        <div class="ht-trainer-shell" id="htTrainerShell">
            <script>
                (function () {
                    try {
                        var s = localStorage.getItem('ht-sidebar-collapsed');
                        var tablet = window.matchMedia('(min-width: 768px) and (max-width: 1099.98px)').matches;
                        if (s === '1' || (s === null && tablet)) {
                            document.getElementById('htTrainerShell').classList.add('sidebar-collapsed');
                        }
                    } catch (e) { }
                })();
            </script>

            <aside class="ht-sidebar" id="htSidebar">
                <div class="ht-sidebar-brand">
                    <a class="ht-brand" href="@Url.Action("Index", "Trainer")" aria-label="HealthTrack trainer overview">
                        @Html.Partial("_Brand")
                    </a>
                </div>

                <div class="ht-sidebar-section-label">TRAINER / WORKSPACE</div>

                <nav class="ht-sidebar-nav" aria-label="Trainer navigation">
                    <a class="ht-side-link @(ctrl == "Trainer" && act == "Index" ? "active" : "")" href="@Url.Action("Index", "Trainer")" title="Overview">
                        <span class="ht-side-num">01</span><span class="ht-side-label">Overview</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "Trainer" && (act == "Clients" || act == "AddClient") ? "active" : "")" href="@Url.Action("Clients", "Trainer")" title="Client list">
                        <span class="ht-side-num">02</span><span class="ht-side-label">Client list</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "WorkoutPlans" || ctrl == "DietPlans" ? "active" : "")" href="@Url.Action("Index", "WorkoutPlans")" title="Create plans">
                        <span class="ht-side-num">03</span><span class="ht-side-label">Create plans</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "Appointments" ? "active" : "")" href="@Url.Action("Index", "Appointments")" title="Appointments">
                        <span class="ht-side-num">04</span><span class="ht-side-label">Appointments</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "Feedback" ? "active" : "")" href="@Url.Action("Index", "Feedback")" title="Feedback">
                        <span class="ht-side-num">05</span><span class="ht-side-label">Feedback</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "Reports" ? "active" : "")" href="@Url.Action("Index", "Reports")" title="Reports">
                        <span class="ht-side-num">06</span><span class="ht-side-label">Reports</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "Notifications" ? "active" : "")" href="@Url.Action("Index", "Notifications")" title="Notifications">
                        <span class="ht-side-num">07</span><span class="ht-side-label">Notifications</span>
                        @if (unread > 0)
                        {<span class="ht-side-badge">@unread</span>}
                    </a>
                    <a class="ht-side-link @(ctrl == "TrainerRequests" ? "active" : "")"
                       href="@Url.Action("Index", "TrainerRequests")"
                       title="Trainer Requests"
                       aria-current="@(ctrl == "TrainerRequests" ? "page" : null)">
                        <span class="ht-side-num">08</span><span class="ht-side-label">Trainer Requests</span>
                    </a>
                    <a class="ht-side-link @(ctrl == "TrainerSelection" ? "active" : "")"
                       href="@Url.Action("Index", "TrainerSelection")"
                       title="Client Selections"
                       aria-current="@(ctrl == "TrainerSelection" ? "page" : null)">
                        <span class="ht-side-num">09</span><span class="ht-side-label">Client Selections</span>
                    </a>
                </nav>

                <div class="ht-sidebar-bottom">
                    <div class="ht-sidebar-profile">
                        <button type="button" class="ht-profile-avatar" data-profile-toggle aria-label="Profile and settings" title="Profile and settings">@sideInitials</button>
                        <span class="ht-profile-info">
                            <strong>@sideName</strong>
                            <small>Trainer</small>
                        </span>
                        <button type="button" class="ht-profile-cog @(ctrl == "Profile" ? "active" : "")" data-profile-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="htProfileMenu" aria-label="Profile and settings" title="Profile and settings">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                        </button>
                    </div>

                    <button type="button" class="ht-sidebar-collapse" id="htSidebarCollapse" aria-label="Collapse sidebar" title="Collapse sidebar">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        <span>Collapse</span>
                    </button>
                </div>
            </aside>

            <div class="ht-sidebar-overlay" id="htSidebarOverlay"></div>

            <div class="ht-profile-menu" id="htProfileMenu" role="menu" hidden>
                <div class="ht-profile-menu-head">
                    <strong>@sideName</strong>
                    <small>@User.Identity.Name</small>
                </div>
                <a role="menuitem" class="@(ctrl == "Profile" && act == "Index" ? "active" : "")" href="@Url.Action("Index", "Profile")">Profile</a>
                <a role="menuitem" class="@(ctrl == "Profile" && act == "Settings" ? "active" : "")" href="@Url.Action("Settings", "Profile")">Settings</a>
            </div>

            <div class="ht-trainer-main">
                <header class="ht-trainer-topbar">
                    <button type="button" class="ht-mobile-menu" id="htMobileMenu" aria-label="Open navigation" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>

                    <div class="ht-topbar-spacer"></div>

                    <button type="button" class="ht-theme-toggle" data-theme-toggle aria-label="Switch light / dark theme" title="Switch light / dark theme">
                        <svg class="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                        <svg class="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
                    </button>

                    <span class="ht-topbar-user">@sideName</span>

                    @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { @class = "ht-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ht-logout-button">Logout</button>
                    }
                </header>

                <main class="ht-trainer-content">
                    @RenderBody()

                    <footer class="ht-trainer-footer">
                        <p>&copy; @DateTime.Now.Year &mdash; <span class="footer-brand">HealthTrack</span></p>
                    </footer>
                </main>
            </div>
        </div>
    }
    else
    {
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand ht-brand" href="@Url.Action("Index", "Home", new { area = "" })">
                    @Html.Partial("_Brand")
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        @if (User.IsInRole("Client"))
                        {
                            <li>@Html.ActionLink("My plans", "Plans", "Client", new { area = "" }, new { @class = "nav-link" })</li>
                        }
                        <li>@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>

                    <ul class="navbar-nav align-items-sm-center">
                        <li class="me-sm-3">
                            <button type="button" class="ht-theme-toggle" data-theme-toggle aria-label="Switch light / dark theme" title="Switch light / dark theme">
                                <svg class="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                                <svg class="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
                            </button>
                        </li>
                        @if (Request.IsAuthenticated)
                        {
                            <li><span class="nav-link">@User.Identity.Name</span></li>
                            <li>
                                @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                }
                            </li>
                        }
                        else
                        {
                            <li>@Html.ActionLink("Log in", "Login", "Account", new { area = "" }, new { @class = "nav-link" })</li>
                            <li class="ms-sm-2">@Html.ActionLink("Register", "Register", "Account", new { area = "" }, new { @class = "ht-nav-cta" })</li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content">
            @RenderBody()
            <hr />
            <footer>
                <p>&copy; @DateTime.Now.Year &mdash; <span class="footer-brand">HealthTrack</span></p>
            </footer>
        </div>
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Html.Partial("_ThemeScripts")
    <script src="@Url.Content("~/Scripts/sidebar.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
