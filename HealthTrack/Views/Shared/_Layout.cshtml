<!DOCTYPE html>
<html lang="en" data-theme="dark" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HealthTrack</title>

    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/favicon.svg")" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@800&display=swap"
          rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Html.Partial("_ThemeHead")
    <link href="@Url.Content("~/Content/brand.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/sidebar.css")" rel="stylesheet" />

    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        bool isTrainer = Request.IsAuthenticated && User.IsInRole("Trainer");
        string currentController = Convert.ToString(
            ViewContext.RouteData.Values["controller"]);
        string currentAction = Convert.ToString(
            ViewContext.RouteData.Values["action"]);
    }

    @if (isTrainer)
    {
        <div class="ht-trainer-shell" id="htTrainerShell">

            <!-- SIDEBAR -->
            <aside class="ht-sidebar" id="htSidebar">

                <a class="ht-sidebar-brand"
                   href="@Url.Action("Index", "Trainer")"
                   aria-label="HealthTrack trainer dashboard">

                    <svg class="ht-sidebar-logo" viewBox="0 0 64 64"
                         aria-hidden="true">
                        <defs>
                            <linearGradient id="htSidebarGradient"
                                            x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#22d3ee" />
                                <stop offset="1" stop-color="#0d9488" />
                            </linearGradient>
                        </defs>
                        <rect width="64" height="64" rx="14"
                              fill="url(#htSidebarGradient)" />
                        <polyline points="8,34 21,34 27,19 35,47 41,27 45,34 56,34"
                                  fill="none" stroke="#fff" stroke-width="5.2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                    </svg>

                    <span class="ht-sidebar-brand-text">
                        <span class="b-health">Health</span><span class="b-track">Track</span>
                    </span>
                </a>

                <div class="ht-sidebar-section-label">WORKSPACE</div>

                <nav class="ht-sidebar-nav" aria-label="Trainer navigation">

                    <a class="ht-side-link @(currentController == "Trainer" && currentAction == "Index" ? "active" : "")"
                       href="@Url.Action("Index", "Trainer")"
                       title="Overview">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z" />
                        </svg>
                        <span>Overview</span>
                    </a>

                    <a class="ht-side-link @(currentController == "Trainer" && currentAction == "Clients" ? "active" : "")"
                       href="@Url.Action("Clients", "Trainer")"
                       title="My clients">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="10" cy="7" r="4" />
                            <path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        <span>My Clients</span>
                    </a>

                    <a class="ht-side-link @(currentController == "Trainer" && currentAction == "Appointments" ? "active" : "")"
                       href="@Url.Action("Appointments", "Trainer")"
                       title="Appointments">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 11h18" />
                        </svg>
                        <span>Appointments</span>
                    </a>

                    <a class="ht-side-link @(currentController == "WorkoutPlans" ? "active" : "")"
                       href="@Url.Action("Index", "WorkoutPlans")"
                       title="Workout plans">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 9v6M3 10v4M18 9v6M21 10v4M6 12h12" />
                        </svg>
                        <span>Workout Plans</span>
                    </a>

                    <a class="ht-side-link @(currentController == "DietPlans" ? "active" : "")"
                       href="@Url.Action("Index", "DietPlans")"
                       title="Diet plans">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3v7M4 3v4a3 3 0 0 0 6 0V3M7 10v11M16 3c-2 3-3 6-3 10h3v8M16 3v10" />
                        </svg>
                        <span>Diet Plans</span>
                    </a>

                    <a class="ht-side-link @(currentController == "Feedback" ? "active" : "")"
                       href="@Url.Action("Index", "Feedback")"
                       title="Feedback">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3h.5a8.5 8.5 0 0 1 8 8z" />
                        </svg>
                        <span>Feedback</span>
                    </a>

                    <a class="ht-side-link @(currentController == "Reports" ? "active" : "")"
                       href="@Url.Action("Index", "Reports")"
                       title="Reports">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 19V10M10 19V5M16 19v-8M22 19V3" />
                        </svg>
                        <span>Reports</span>
                    </a>

                    <a class="ht-side-link @(currentController == "Notifications" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications")"
                       title="Notifications">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                        </svg>
                        <span>Notifications</span>
                    </a>
                </nav>

                <div class="ht-sidebar-bottom">
                    <a class="ht-sidebar-profile"
                       href="@Url.Action("Index", "Manage")"
                       title="Account settings">
                        <span class="ht-profile-avatar">
                            @{
                                string trainerName = User.Identity.Name ?? "Trainer";
                                string initials = trainerName.Length > 0
                                    ? trainerName.Substring(0, 1).ToUpperInvariant()
                                    : "T";
                            }
                            @initials
                        </span>

                        <span class="ht-profile-info">
                            <strong>@trainerName</strong>
                            <small>Trainer</small>
                        </span>

                        <svg class="ht-profile-settings" viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="3" />
                            <path d="m19.4 15 .1.1a2 2 0 0 1-2.8 2.8l-.1-.1a2 2 0 0 0-3.4 1.4v.3a2 2 0 0 1-4 0v-.2a2 2 0 0 0-3.4-1.4l-.1.1a2 2 0 0 1-2.8-2.8l.1-.1A2 2 0 0 0 1.6 12H1.5a2 2 0 0 1 0-4h.2a2 2 0 0 0 1.4-3.4L3 4.5a2 2 0 0 1 2.8-2.8l.1.1a2 2 0 0 0 3.4-1.4V.3a2 2 0 0 1 4 0v.2a2 2 0 0 0 3.4 1.4l.1-.1a2 2 0 0 1 2.8 2.8l-.1.1a2 2 0 0 0 1.4 3.4h.2a2 2 0 0 1 0 4h-.2a2 2 0 0 0-1.4 3.4z"
                                  transform="translate(2 2) scale(.83)" />
                        </svg>
                    </a>

                    <button type="button" class="ht-sidebar-collapse"
                            id="htSidebarCollapse" aria-label="Collapse sidebar"
                            title="Collapse sidebar">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                        <span>Collapse sidebar</span>
                    </button>
                </div>
            </aside>

            <div class="ht-sidebar-overlay" id="htSidebarOverlay"></div>

            <!-- MAIN AREA -->
            <div class="ht-trainer-main">

                <header class="ht-trainer-topbar">
                    <button type="button" class="ht-mobile-menu"
                            id="htMobileMenu" aria-label="Open navigation"
                            aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div class="ht-topbar-spacer"></div>

                    <button type="button" class="ht-theme-toggle"
                            data-theme-toggle
                            aria-label="Switch light / dark theme"
                            title="Switch light / dark theme">
                        <svg class="i-sun" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        </svg>
                        <svg class="i-moon" viewBox="0 0 24 24">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
                        </svg>
                    </button>

                    <span class="ht-topbar-user">@User.Identity.Name</span>

                    @using (Html.BeginForm("Logout", "Account",
                        new { area = "" }, FormMethod.Post,
                        new { @class = "ht-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ht-logout-button">
                            Logout
                        </button>
                    }
                </header>

                <main class="ht-trainer-content">
                    @RenderBody()

                    <footer class="ht-trainer-footer">
                        <p>
                            &copy; @DateTime.Now.Year -
                            <span class="footer-brand">HealthTrack</span>
                        </p>
                    </footer>
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- EXISTING NAVIGATION FOR VISITORS AND CLIENTS -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand brand-ht"
                   href="@Url.Action("Index", "Home", new { area = "" })">
                    <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
                        <defs>
                            <linearGradient id="bm" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#22d3ee" />
                                <stop offset="1" stop-color="#0d9488" />
                            </linearGradient>
                        </defs>
                        <rect width="64" height="64" rx="14" fill="url(#bm)" />
                        <polyline points="8,34 21,34 27,19 35,47 41,27 45,34 56,34"
                                  fill="none" stroke="#fff" stroke-width="5.2"
                                  stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span><span class="b-health">Health</span><span class="b-track">Track</span></span>
                </a>

                <button type="button" class="navbar-toggler"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>

                        @if (User.IsInRole("Client"))
                        {
                            <li>@Html.ActionLink("My plans", "Plans", "Client", new { area = "" }, new { @class = "nav-link" })</li>
                        }

                        <li>@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>

                    <ul class="navbar-nav align-items-sm-center">
                        <li class="me-sm-2">
                            <button type="button" class="ht-theme-toggle"
                                    data-theme-toggle
                                    aria-label="Switch light / dark theme"
                                    title="Switch light / dark theme">
                                <svg class="i-sun" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="4" />
                                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                                </svg>
                                <svg class="i-moon" viewBox="0 0 24 24">
                                    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
                                </svg>
                            </button>
                        </li>

                        @if (Request.IsAuthenticated)
                        {
                            <li><span class="nav-link">Hi, @User.Identity.Name</span></li>
                            <li>
                                @using (Html.BeginForm("Logout", "Account",
                                    new { area = "" }, FormMethod.Post,
                                    new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                }
                            </li>
                        }
                        else
                        {
                            <li>@Html.ActionLink("Login", "Login", "Account", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Register", "Register", "Account", new { area = "" }, new { @class = "nav-link" })</li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content">
            @RenderBody()
            <hr />
            <footer>
                <p>
                    &copy; @DateTime.Now.Year -
                    <span class="footer-brand">HealthTrack</span>
                </p>
            </footer>
        </div>
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Html.Partial("_ThemeScripts")
    <script src="@Url.Content("~/Scripts/theme.js")"></script>
    <script src="@Url.Content("~/Scripts/sidebar.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>