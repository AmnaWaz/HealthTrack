@model HealthTrack.ViewModels.ChangePasswordViewModel
@{ ViewBag.Title = "Settings"; }
<link href="@Url.Content("~/Content/profile.css")" rel="stylesheet" />
<div class="ht-page">
    <div class="ht-page-head">
        <div>
            <p class="ht-eyebrow">Trainer / Settings</p>
            <h1 class="ht-h1">Your<br />settings.</h1>
            <p class="ht-sub">Appearance, workspace preferences and account security.</p>
        </div>
    </div>
    <div class="ht-tabs">
        @Html.ActionLink("Profile", "Index", "Profile", null, new { @class = "ht-tab" })
        @Html.ActionLink("Settings", "Settings", "Profile", null, new { @class = "ht-tab active", aria_current = "page" })
    </div>
    @if (TempData["Success"] != null) { <div class="ht-alert ok" role="status">@TempData["Success"]</div> }
    <div class="ht-grid-2">
        <section class="ht-card">
            <div class="ht-card-head"><h2 class="ht-card-title">Preferences</h2></div>
            <div class="ht-setting-row">
                <div>
                    <p class="ht-setting-title">Appearance</p>
                    <p class="ht-setting-sub">Choose the cream or navy workspace theme.</p>
                </div>
                <div class="ht-seg" role="group" aria-label="Display theme">
                    <button type="button" data-set-theme="light">Light</button>
                    <button type="button" data-set-theme="dark">Dark</button>
                </div>
            </div>
            <div class="ht-setting-row">
                <div>
                    <p class="ht-setting-title">Collapsed sidebar</p>
                    <p class="ht-setting-sub">Keep the navigation compact on desktop.</p>
                </div>
                <label class="ht-switch" title="Start with collapsed sidebar">
                    <input type="checkbox" id="sidebarPref" aria-label="Collapsed sidebar preference" />
                    <span></span>
                </label>
            </div>
            <div class="ht-setting-row">
                <div>
                    <p class="ht-setting-title">Profile information</p>
                    <p class="ht-setting-sub">Update your coaching details and public profile.</p>
                </div>
                @Html.ActionLink("Edit profile →", "Index", "Profile", null, new { @class = "ht-btn" })
            </div>
        </section>
        <section class="ht-card">
            <div class="ht-card-head"><h2 class="ht-card-title">Account security</h2></div>
            @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-4">
                    @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger" })
                </div>
                <div class="mb-4">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                </div>
                <div class="mb-4">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="ht-btn">Update password</button>
            }
        </section>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-set-theme]'));
            function markTheme() {
                var theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
                buttons.forEach(function (button) {
                    var selected = button.getAttribute('data-set-theme') === theme;
                    button.classList.toggle('active', selected);
                    button.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });
            }
            buttons.forEach(function (button) {
                button.addEventListener('click', function () {
                    if (window.HealthTheme && typeof window.HealthTheme.set === 'function') {
                        window.HealthTheme.set(button.getAttribute('data-set-theme'));
                    }
                    markTheme();
                });
            });
            document.addEventListener('ht-theme-change', markTheme);
            markTheme();

            var preference = document.getElementById('sidebarPref');
            if (!preference) return;
            try { preference.checked = localStorage.getItem('ht-sidebar-collapsed') === '1'; } catch (e) { }
            preference.addEventListener('change', function () {
                try { localStorage.setItem('ht-sidebar-collapsed', preference.checked ? '1' : '0'); } catch (e) { }
                var shell = document.getElementById('htTrainerShell');
                if (shell && !window.matchMedia('(max-width: 767.98px)').matches) {
                    shell.classList.toggle('sidebar-collapsed', preference.checked);
                }
            });
        })();
    </script>
}
