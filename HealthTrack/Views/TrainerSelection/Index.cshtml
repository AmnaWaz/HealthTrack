
@model HealthTrack.ViewModels.TrainerSelectionViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Trainer Selection";

    var pending = Model.Requests
        .Where(r => r.Status == "Pending")
        .ToList();

    var history = Model.Requests
        .Where(r => r.Status != "Pending")
        .ToList();
}

<style>
    .tsa-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 28px 14px 70px;
    }

    .tsa-eyebrow {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .tsa-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 30px;
    }

        .tsa-header h1 {
            margin: 8px 0;
            font: 700 clamp(38px, 5vw, 62px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .tsa-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .tsa-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid #b6505d;
        background: #b6505d;
        color: #fff;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
    }

        .tsa-button:hover {
            background: #963f4a;
            color: #fff;
        }

    .tsa-button-outline {
        background: transparent;
        border-color: #aeb3ba;
        color: inherit;
    }

        .tsa-button-outline:hover {
            border-color: #b6505d;
            background: transparent;
            color: #b6505d;
        }

    .tsa-button-reject {
        background: transparent;
        border-color: #b6505d;
        color: #b6505d;
    }

        .tsa-button-reject:hover {
            background: rgba(182, 80, 93, .1);
            color: #b6505d;
        }

    .tsa-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 36px;
    }

    .tsa-stat,
    .tsa-card,
    .tsa-history {
        background: var(--ht-surface, #f4f0e8);
        border: 1px solid var(--ht-border, #b9bdc2);
        min-width: 0;
    }

    .tsa-stat {
        padding: 21px;
    }

        .tsa-stat span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .tsa-stat strong {
            font: 700 36px "Archivo Narrow", sans-serif;
        }

    .tsa-section {
        margin-top: 34px;
    }

        .tsa-section h2 {
            font: 700 29px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin: 8px 0 20px;
        }

    .tsa-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .tsa-card {
        padding: 23px;
    }

    .tsa-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 19px;
    }

    .tsa-card h3 {
        margin: 8px 0;
        font: 700 27px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        overflow-wrap: anywhere;
    }

    .tsa-status {
        display: inline-flex;
        padding: 7px 10px;
        border: 1px solid #aeb3ba;
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .tsa-status-pending {
        border-color: #b58c55;
        color: #b58c55;
    }

    .tsa-status-accepted {
        border-color: #65967c;
        color: #65967c;
    }

    .tsa-status-rejected {
        border-color: #b6505d;
        color: #b6505d;
    }

    .tsa-goals {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 13px 0 21px;
    }

    .tsa-goal {
        padding: 8px 11px;
        border: 1px solid var(--ht-border, #b9bdc2);
        font: 600 10px "IBM Plex Mono", monospace;
    }

    .tsa-field {
        margin: 18px 0;
    }

        .tsa-field label {
            display: block;
            margin-bottom: 9px;
            font: 600 11px "IBM Plex Mono", monospace;
            text-transform: uppercase;
        }

        .tsa-field textarea {
            width: 100%;
            min-height: 94px;
            padding: 12px;
            border: 1px solid #aeb3ba;
            background: transparent;
            color: inherit;
            font-size: 13px;
            line-height: 1.7;
            resize: vertical;
        }

            .tsa-field textarea:focus-visible {
                outline: 2px solid #b6505d;
            }

    .tsa-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 17px;
    }

        .tsa-actions form {
            margin: 0;
        }

    .tsa-alert {
        padding: 14px 17px;
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .1);
        margin-bottom: 20px;
        font-size: 13px;
    }

    .tsa-alert-error {
        border-color: #b6505d;
        background: rgba(182, 80, 93, .09);
    }

    .tsa-history {
        padding: 23px;
    }

    .tsa-history-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 17px 0;
        border-top: 1px solid var(--ht-border, #b9bdc2);
    }

        .tsa-history-row:first-child {
            border-top: 0;
            padding-top: 0;
        }

        .tsa-history-row strong {
            display: block;
            margin-bottom: 7px;
        }

    .tsa-note {
        margin-top: 9px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 12px;
    }

    .tsa-empty {
        text-align: center;
        padding: 45px 20px;
        border: 1px dashed #aeb3ba;
    }

    @@media (max-width: 900px) {
        .tsa-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .tsa-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .tsa-header,
        .tsa-card-head,
        .tsa-history-row {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="tsa-page">
    <header class="tsa-header">
        <div>
            <span class="tsa-eyebrow">TRAINER / CLIENT ASSIGNMENT</span>
            <h1>CLIENT REQUESTS</h1>
            <p class="tsa-muted">
                Review clients who have selected you as their preferred trainer.
            </p>
        </div>

        <a class="tsa-button tsa-button-outline"
           href="@Url.Action("Index", "Trainer")">
            BACK TO OVERVIEW
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="tsa-alert" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="tsa-alert tsa-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="tsa-stats">
        <div class="tsa-stat">
            <span>Pending</span>
            <strong>@Model.PendingCount</strong>
        </div>
        <div class="tsa-stat">
            <span>Accepted</span>
            <strong>@Model.AcceptedCount</strong>
        </div>
        <div class="tsa-stat">
            <span>Rejected</span>
            <strong>@Model.RejectedCount</strong>
        </div>
        <div class="tsa-stat">
            <span>Cancelled</span>
            <strong>@Model.CancelledCount</strong>
        </div>
    </div>

    <section class="tsa-section">
        <span class="tsa-eyebrow">01 / AWAITING YOUR DECISION</span>
        <h2>PENDING REQUESTS</h2>

        @if (pending.Any())
        {
            <div class="tsa-grid">
                @foreach (var request in pending)
                {
                    <article class="tsa-card">
                        <div class="tsa-card-head">
                            <div>
                                <span class="tsa-eyebrow">
                                    REQUEST #@request.TrainerSelectionRequestId
                                </span>
                                <h3>@request.ClientName</h3>
                                <p class="tsa-muted">
                                    Requested @request.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </p>
                            </div>

                            <span class="tsa-status tsa-status-pending">
                                PENDING
                            </span>
                        </div>

                        <span class="tsa-eyebrow">CLIENT FITNESS GOALS</span>

                        @if (request.FitnessGoals.Any())
                        {
                            <div class="tsa-goals">
                                @foreach (var goal in request.FitnessGoals)
                                {
                                    <span class="tsa-goal">@goal</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="tsa-muted" style="margin-top:12px">
                                No fitness goals listed.
                            </p>
                        }

                        <div class="tsa-field">
                            <label for="note-@request.TrainerSelectionRequestId">
                                Optional message to client
                            </label>
                            <textarea id="note-@request.TrainerSelectionRequestId"
                                      name="TrainerNote"
                                      form="accept-@request.TrainerSelectionRequestId"
                                      maxlength="500"
                                      placeholder="Add a message about your decision..."></textarea>
                        </div>

                        <div class="tsa-actions">
                            @using (Html.BeginForm("Accept", "TrainerSelection", FormMethod.Post, new { id = "accept-" + request.TrainerSelectionRequestId }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="TrainerSelectionRequestId"
                                       value="@request.TrainerSelectionRequestId" />

                                <button type="submit"
                                        class="tsa-button"
                                        onclick="return confirm('Accept this client as your trainee?');">
                                    ACCEPT CLIENT
                                </button>
                            }

                            @using (Html.BeginForm("Reject", "TrainerSelection", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="TrainerSelectionRequestId"
                                       value="@request.TrainerSelectionRequestId" />

                                <input type="hidden"
                                       name="TrainerNote"
                                       class="tsa-reject-note"
                                       value="" />

                                <button type="submit"
                                        class="tsa-button tsa-button-reject"
                                        data-reject-id="@request.TrainerSelectionRequestId">
                                    REJECT
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="tsa-empty">
                <h2>NO PENDING REQUESTS</h2>
                <p class="tsa-muted">
                    New trainer-selection requests will appear here.
                </p>
            </div>
        }
    </section>

    <section class="tsa-section">
        <span class="tsa-eyebrow">02 / PREVIOUS DECISIONS</span>
        <h2>REQUEST HISTORY</h2>

        <div class="tsa-history">
            @if (history.Any())
            {
                foreach (var request in history)
                {
                    var statusClass = request.Status == "Accepted"
                        ? "tsa-status-accepted"
                        : request.Status == "Rejected"
                            ? "tsa-status-rejected"
                            : "";

                    <div class="tsa-history-row">
                        <div>
                            <strong>@request.ClientName</strong>

                            <span class="tsa-muted">
                                Requested @request.CreatedAt.ToString("dd MMM yyyy")
                            </span>

                            @if (request.RespondedAt.HasValue)
                            {
                                <span class="tsa-muted">
                                    · Updated @request.RespondedAt.Value.ToString("dd MMM yyyy")
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(request.TrainerNote))
                            {
                                <p class="tsa-note">
                                    @request.TrainerNote
                                </p>
                            }
                        </div>

                        <span class="tsa-status @statusClass">
                            @request.Status
                        </span>
                    </div>
                }
            }
            else
            {
                <p class="tsa-muted">
                    No previous trainer-selection decisions.
                </p>
            }
        </div>
    </section>
</div>

@section scripts {
    <script>
        (function () {
            document.querySelectorAll("[data-reject-id]").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    var id = button.getAttribute("data-reject-id");
                    var note = document.getElementById("note-" + id);
                    var form = button.closest("form");
                    var hiddenNote = form.querySelector(".tsa-reject-note");

                    if (!confirm("Reject this client request?")) {
                        event.preventDefault();
                        return;
                    }

                    hiddenNote.value = note ? note.value : "";
                });
            });
        })();
    </script>
}
