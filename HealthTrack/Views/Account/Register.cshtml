@model HealthTrack.ViewModels.RegisterViewModel
@{ ViewBag.Title = "Register"; }
<link href="~/Content/auth.css" rel="stylesheet" />

<section class="ht-auth">
    <div class="ht-auth-hero">
        <p class="ht-eyebrow">Join HealthTrack.</p>
        <h1 class="ht-display">Start<br />the first<br />round.</h1>
        <p class="ht-lead">Create an account as a client or a trainer. It takes a minute, and no experience is needed.</p>
    </div>
    <div class="ht-auth-panel">
        <div class="ht-auth-box">
            <h2 class="ht-card-title">Create account</h2>
            @if (TempData["Error"] != null)
            {<div class="ht-alert bad">@TempData["Error"]</div>}
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
                @Html.HiddenFor(m => m.Role)

                <label class="auth-label first">I am a</label>
                <div class="auth-pills">
                    <button type="button" class="auth-pill" data-role="Client">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg> Client
                    </button>
                    <button type="button" class="auth-pill" data-role="Trainer">
                        <svg viewBox="0 0 24 24"><path d="M6 8v8M18 8v8M3 10v4M21 10v4M6 12h12" /></svg> Trainer
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Role)

                <div class="auth-row">
                    <div>
                        <label class="auth-label" for="FirstName">First name</label>
                        <div class="auth-field">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                            @Html.TextBoxFor(m => m.FirstName, new { placeholder = "Ava" })
                        </div>
                        @Html.ValidationMessageFor(m => m.FirstName)
                    </div>
                    <div>
                        <label class="auth-label" for="LastName">Last name</label>
                        <div class="auth-field">
                            @Html.TextBoxFor(m => m.LastName, new { placeholder = "Thompson" })
                        </div>
                        @Html.ValidationMessageFor(m => m.LastName)
                    </div>
                </div>

                <label class="auth-label" for="Email">Email</label>
                <div class="auth-field">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
                    @Html.TextBoxFor(m => m.Email, new { placeholder = "you@email.com", autocomplete = "email" })
                </div>
                @Html.ValidationMessageFor(m => m.Email)

                <label class="auth-label" for="Phone">Phone</label>
                <div class="auth-field">
                    <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" /></svg>
                    @Html.TextBoxFor(m => m.Phone, new { placeholder = "Phone number", autocomplete = "tel", type = "tel" })
                </div>
                @Html.ValidationMessageFor(m => m.Phone)

                <label class="auth-label" for="Password">Password</label>
                <div class="auth-field" id="pwField">
                    <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
                    @Html.PasswordFor(m => m.Password, new { placeholder = "Create a password", autocomplete = "new-password" })
                    <svg class="auth-tick" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg>
                    <button type="button" class="auth-eye" data-eye="Password" aria-label="Show password">
                        <svg viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password)

                <div class="auth-strength" id="pwStrength">
                    <div class="auth-bars"><span></span><span></span><span></span><span></span><span></span></div>
                    <small>Password strength: <b id="pwLabel"></b></small>
                    <div class="auth-req" id="pwReq"></div>
                </div>

                <label class="auth-label" for="ConfirmPassword">Confirm password</label>
                <div class="auth-field">
                    <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Re-enter your password", autocomplete = "new-password" })
                    <button type="button" class="auth-eye" data-eye="ConfirmPassword" aria-label="Show password">
                        <svg viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword)

                <div id="clientFields">
                    <h5 class="auth-section">Client details</h5>
                    <div class="auth-row">
                        <div>
                            <label class="auth-label" for="DateOfBirth">Date of birth</label>
                            <div class="auth-field">@Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date" })</div>
                            @Html.ValidationMessageFor(m => m.DateOfBirth)
                        </div>
                        <div>
                            <label class="auth-label" for="Gender">Gender</label>
                            <div class="auth-field">@Html.DropDownListFor(m => m.Gender, new SelectList(new[] { "", "Male", "Female", "Other" }, Model.Gender))</div>
                        </div>
                    </div>
                    <div class="auth-row">
                        <div>
                            <label class="auth-label" for="Height">Height (cm)</label>
                            <div class="auth-field">@Html.TextBoxFor(m => m.Height, new { placeholder = "170" })</div>
                        </div>
                        <div>
                            <label class="auth-label" for="Weight">Weight (kg)</label>
                            <div class="auth-field">@Html.TextBoxFor(m => m.Weight, new { placeholder = "65" })</div>
                        </div>
                    </div>
                    <label class="auth-label" for="Goal">Goal</label>
                    <div class="auth-field">@Html.TextBoxFor(m => m.Goal, new { placeholder = "e.g. Build strength" })</div>
                </div>

                <div id="trainerFields" style="display:none">
                    <h5 class="auth-section">Trainer details</h5>
                    <label class="auth-label" for="Specialisation">Specialisation</label>
                    <div class="auth-field">@Html.TextBoxFor(m => m.Specialisation, new { placeholder = "e.g. Strength and conditioning" })</div>
                    <label class="auth-label" for="Bio">Bio</label>
                    <div class="auth-field area">@Html.TextAreaFor(m => m.Bio, 3, 40, new { placeholder = "Tell clients about yourself" })</div>
                </div>

                <button type="submit" class="auth-btn">Create account</button>
                <p class="auth-foot">Already have an account? @Html.ActionLink("Log in", "Login", "Account")</p>
            }
        </div>
    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // role pills
        var roleInput = document.getElementById('Role');
        var pills = document.querySelectorAll('.auth-pill');
        function setRole(r) {
            roleInput.value = r;
            pills.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-role') === r); });
            document.getElementById('clientFields').style.display = r === 'Client' ? '' : 'none';
            document.getElementById('trainerFields').style.display = r === 'Trainer' ? '' : 'none';
        }
        pills.forEach(function (p) { p.addEventListener('click', function () { setRole(p.getAttribute('data-role')); }); });
        setRole(roleInput.value === 'Trainer' ? 'Trainer' : 'Client');

        // show / hide password
        document.querySelectorAll('[data-eye]').forEach(function (b) {
            b.addEventListener('click', function () {
                var i = document.getElementById(b.getAttribute('data-eye'));
                i.type = i.type === 'password' ? 'text' : 'password';
            });
        });

        // password strength meter
        var pw = document.getElementById('Password');
        var box = document.getElementById('pwStrength');
        var bars = box.querySelectorAll('.auth-bars span');
        var label = document.getElementById('pwLabel');
        var req = document.getElementById('pwReq');
        var field = document.getElementById('pwField');
        pw.addEventListener('input', function () {
            var p = pw.value;
            if (!p) { box.style.display = 'none'; field.classList.remove('ok'); return; }
            box.style.display = 'block';
            var s = 0;
            if (p.length >= 8) s++;
            if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++;
            if (/[0-9]/.test(p)) s++;
            if (/[^A-Za-z0-9]/.test(p)) s++;
            if (p.length >= 12) s++;
            var names = ['Weak', 'Weak', 'Fair', 'Good', 'Strong', 'Strong'];
            var colors = ['#ef4444', '#ef4444', '#f59e0b', '#84cc16', '#22c55e', '#22c55e'];
            label.textContent = names[s];
            label.style.color = colors[s];
            bars.forEach(function (b, idx) { b.style.background = idx < s ? colors[s] : 'var(--ht-border)'; });
            var met = p.length >= 8 && /[a-z]/.test(p) && /[A-Z]/.test(p) && /[0-9]/.test(p);
            req.className = 'auth-req' + (met ? ' met' : '');
            req.textContent = met ? 'All requirements met' : 'Use 8+ characters with upper and lower case letters and a number';
            field.classList.toggle('ok', met);
        });
    </script>
}
