@model HealthTrack.ViewModels.TrainerDashboardViewModel
@{ ViewBag.Title = "Overview"; }
<link href="~/Content/stat-accordion.css" rel="stylesheet" />

<div class="ht-page">

    <div class="ht-page-head">
        <div>
            <p class="ht-eyebrow">01 / Overview</p>
            <h1 class="ht-h1">@Model.Greeting,<br />@Model.FirstName.</h1>
            <p class="ht-sub">
                @(string.IsNullOrWhiteSpace(Model.Specialisation) ? "Trainer" : Model.Specialisation)
                &nbsp;&middot;&nbsp;
                @if (Model.AverageRating > 0)
                {<text>&#9733; @Model.AverageRating.ToString("0.0") average rating</text> }
            else
            { <text>No ratings yet</text>}
            </p>
        </div>
        <div class="ht-head-actions">
            <span class="ht-chip">@DateTime.Now.ToString("ddd d MMM yyyy")</span>
            @Html.ActionLink("New session", "Create", "Appointments", null, new { @class = "ht-btn" })
        </div>
    </div>

    @{
        var nextAppt = Model.Appointments.FirstOrDefault();
        var topClients = string.Join(", ", Model.Clients.Take(3).Select(c => c.Name));
    }

    @* Stat cards: only the name shows until you hover (or tap). One opens at a time. *@
    <div class="ht-acc" id="htStatAcc">

        <div class="ht-acc-item" tabindex="0">
            <div class="ht-acc-top"><span class="ht-stat-index">01</span><span class="ht-acc-plus" aria-hidden="true"></span></div>
            <div class="ht-acc-body">
                <div class="ht-stat-value">@Model.ClientCount</div>
                <p class="ht-acc-detail">@(Model.ClientCount > 0 ? topClients + (Model.ClientCount > 3 ? " and " + (Model.ClientCount - 3) + " more." : ".") : "No clients assigned yet.")</p>
                @Html.ActionLink("Client list", "Clients", "Trainer", null, new { @class = "ht-link" })
            </div>
            <div class="ht-acc-name">Clients</div>
        </div>

        <div class="ht-acc-item" tabindex="0">
            <div class="ht-acc-top"><span class="ht-stat-index">02</span><span class="ht-acc-plus" aria-hidden="true"></span></div>
            <div class="ht-acc-body">
                <div class="ht-stat-value">@Model.UpcomingAppointmentCount</div>
                <p class="ht-acc-detail">@(nextAppt != null ? "Next: " + nextAppt.ClientName + ", " + nextAppt.When.ToString("ddd d MMM, h:mm tt") + "." : "Nothing booked yet.")</p>
                @Html.ActionLink("Manage sessions", "Index", "Appointments", null, new { @class = "ht-link" })
            </div>
            <div class="ht-acc-name">Upcoming sessions</div>
        </div>

        <div class="ht-acc-item" tabindex="0">
            <div class="ht-acc-top"><span class="ht-stat-index">03</span><span class="ht-acc-plus" aria-hidden="true"></span></div>
            <div class="ht-acc-body">
                <div class="ht-stat-value">@Model.ActiveWorkoutPlans</div>
                <p class="ht-acc-detail">Workout plans running today across your clients.</p>
                @Html.ActionLink("Workout plans", "Index", "WorkoutPlans", null, new { @class = "ht-link" })
            </div>
            <div class="ht-acc-name">Active workout plans</div>
        </div>

        <div class="ht-acc-item" tabindex="0">
            <div class="ht-acc-top"><span class="ht-stat-index">04</span><span class="ht-acc-plus" aria-hidden="true"></span></div>
            <div class="ht-acc-body">
                <div class="ht-stat-value">@Model.ActiveDietPlans</div>
                <p class="ht-acc-detail">Diet plans running today across your clients.</p>
                @Html.ActionLink("Diet plans", "Index", "DietPlans", null, new { @class = "ht-link" })
            </div>
            <div class="ht-acc-name">Active diet plans</div>
        </div>

    </div>

    <div class="ht-split">

        <section class="ht-card">
            <div class="ht-card-head">
                <h2 class="ht-card-title">Upcoming sessions</h2>
                @Html.ActionLink("Manage", "Index", "Appointments", null, new { @class = "ht-link" })
            </div>
            @if (Model.Appointments.Any())
            {
                <ul class="ht-list">
                    @foreach (var a in Model.Appointments)
                    {
                        var cls = a.Status == "Completed" ? "ok" : (a.Status == "Cancelled" ? "bad" : "");
                        <li>
                            <div class="ht-date"><b>@a.When.ToString("dd")</b><span>@a.When.ToString("MMM")</span></div>
                            <div class="ht-list-main">
                                <p class="ht-list-title">@a.ClientName</p>
                                <p class="ht-list-sub">@a.When.ToString("dddd, h:mm tt")@(string.IsNullOrWhiteSpace(a.Location) ? "" : " · " + a.Location)</p>
                            </div>
                            <span class="ht-badge @cls">@a.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="ht-empty"><div>No upcoming sessions. Book one from the Appointments tab.</div></div>
            }
        </section>

        <section class="ht-card">
            <div class="ht-card-head">
                <h2 class="ht-card-title">Notifications</h2>
                @if (Model.UnreadNotifications > 0)
                {<span class="ht-badge red">@Model.UnreadNotifications new</span> }
            else
            { @Html.ActionLink("View all", "Index", "Notifications", null, new { @class = "ht-link" })}
            </div>
            @if (Model.Notifications.Any())
            {
                <ul class="ht-list">
                    @foreach (var n in Model.Notifications)
                    {
                        <li>
                            <span class="ht-dot @(n.IsRead ? "read" : "")"></span>
                            <div class="ht-list-main">
                                <p class="ht-list-title">@n.Message</p>
                                <p class="ht-list-sub">@n.CreatedAt.ToString("d MMM, h:mm tt")@(string.IsNullOrWhiteSpace(n.Type) ? "" : " · " + n.Type)</p>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="ht-empty"><div>You&rsquo;re all caught up.</div></div>
            }
        </section>
    </div>

    <section class="ht-card">
        <div class="ht-card-head">
            <h2 class="ht-card-title">My clients</h2>
            @Html.ActionLink("Client list", "Clients", "Trainer", null, new { @class = "ht-link" })
        </div>
        @if (Model.Clients.Any())
        {
            <div class="ht-table-wrap">
                <table class="ht-table">
                    <thead>
                        <tr><th>Client</th><th>Goal</th><th>Age</th><th>Height</th><th>Weight</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Clients)
                        {
                            <tr>
                                <td data-label="Client"><div class="ht-name"><span class="ht-avatar">@c.Initials</span>@c.Name</div></td>
                                <td data-label="Goal">@(string.IsNullOrWhiteSpace(c.Goal) ? "—" : c.Goal)</td>
                                <td data-label="Age">@c.Age</td>
                                <td data-label="Height">@(c.Height > 0 ? c.Height.ToString("0.#") + " cm" : "—")</td>
                                <td data-label="Weight">@(c.Weight > 0 ? c.Weight.ToString("0.#") + " kg" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ht-empty"><div>No clients assigned to you yet.</div></div>
        }
    </section>

</div>

@section scripts {
    <script>(function () {
      var acc = document.getElementById('htStatAcc');
      if (!acc) { return; }
      var items = [].slice.call(acc.querySelectorAll('.ht-acc-item'));
      var canHover = window.matchMedia('(hover: hover)').matches;

      function toggle(item) {
        var open = !item.classList.contains('is-open');
        items.forEach(function (i) { i.classList.remove('is-open'); });   // opening one closes the others
        if (open) { item.classList.add('is-open'); }
      }
      items.forEach(function (item) {
        item.addEventListener('click', function (e) {
          if (canHover || (e.target.closest && e.target.closest('a'))) { return; }   // mouse users: hover does the work
          toggle(item);
        });
        item.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(item); }
        });
      });
    })();</script>
}
