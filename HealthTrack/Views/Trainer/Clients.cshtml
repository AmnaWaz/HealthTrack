@model HealthTrack.ViewModels.TrainerClientsViewModel
@{ ViewBag.Title = "Client list"; }

<div class="ht-page">
    <div class="ht-page-head">
        <div>
            <p class="ht-eyebrow">02 / Client list</p>
            <h1 class="ht-h1">Your<br />clients.</h1>
            <p class="ht-sub">Manage the clients who selected you as their trainer. New requests are reviewed in Client Selections.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {<div class="ht-alert ok">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="ht-alert bad">@TempData["Error"]</div>}

    <section class="ht-card" style="margin-bottom:20px">
        <div class="ht-card-head">
            <h2 class="ht-card-title">My clients</h2>
            <span class="ht-badge">@Model.Mine.Count</span>
        </div>
        @if (Model.Mine.Any())
        {
            <div class="ht-table-wrap">
                <table class="ht-table">
                    <thead>
                        <tr><th>Client</th><th>Goal</th><th>Age</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Mine)
                        {
                            <tr>
                                <td data-label="Client"><div class="ht-name"><span class="ht-avatar" style="overflow:hidden;display:inline-flex;align-items:center;justify-content:center">
                                        @if (!string.IsNullOrWhiteSpace(c.ProfilePhotoPath)) {
                                            <img src="@Url.Content(c.ProfilePhotoPath)" alt="@c.Name" style="width:100%;height:100%;object-fit:cover" />
                                        } else { @c.Initials }
                                    </span>@c.Name</div></td>
                                <td data-label="Goal">@(string.IsNullOrWhiteSpace(c.Goal) ? "—" : c.Goal)</td>
                                <td data-label="Age">@c.Age</td>
                                <td data-label="Actions">
                                    <div class="ht-actions" style="justify-content:flex-start">
                                        @Html.ActionLink("Workout plan", "Create", "WorkoutPlans", new { clientId = c.ClientId }, new { @class = "ht-btn-ghost" })
                                        @Html.ActionLink("Diet plan", "Create", "DietPlans", new { clientId = c.ClientId }, new { @class = "ht-btn-ghost" })
                                        @Html.ActionLink("Session", "Create", "Appointments", new { clientId = c.ClientId }, new { @class = "ht-btn-ghost" })
                                        @Html.ActionLink("Feedback", "Index", "Feedback", new { clientId = c.ClientId }, new { @class = "ht-btn-ghost" })
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ht-empty"><div>No assigned clients yet. Clients can find you in the trainer directory and send a selection request.</div></div>
        }
    </section>

    <section class="ht-card">
        <div class="ht-card-head">
            <h2 class="ht-card-title">New client requests</h2>
        </div>
        <p class="ht-sub">Clients choose a trainer from their directory. Review their requests before an assignment is created.</p>
        @Html.ActionLink("Review client selections", "Index", "TrainerSelection", null, new { @class = "ht-btn-ghost" })
    </section>
</div>
