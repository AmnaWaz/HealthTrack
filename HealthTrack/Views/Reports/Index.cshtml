@model HealthTrack.ViewModels.ReportsViewModel
@{ ViewBag.Title = "Reports"; }

<div class="ht-page">

    <div class="ht-page-head">
        <div>
            <p class="ht-eyebrow">06 / Reports</p>
            <h1 class="ht-h1">Progress,<br />in numbers.</h1>
            <p class="ht-sub">What your clients logged over the last @Model.Days days: workouts, meals and body weight.</p>
        </div>
    </div>

    <div class="ht-tabs">
        <a class="ht-tab @(Model.Days == 7 ? "active" : "")" href="@Url.Action("Index", "Reports", new { days = 7 })">7 days</a>
        <a class="ht-tab @(Model.Days == 30 ? "active" : "")" href="@Url.Action("Index", "Reports", new { days = 30 })">30 days</a>
        <a class="ht-tab @(Model.Days == 90 ? "active" : "")" href="@Url.Action("Index", "Reports", new { days = 90 })">90 days</a>
    </div>

    <div class="ht-grid-4">
        <div class="ht-card ht-stat">
            <div class="ht-stat-index">01</div>
            <div class="ht-stat-value">@Model.TotalWorkouts</div>
            <div class="ht-stat-label">Workouts logged</div>
        </div>
        <div class="ht-card ht-stat">
            <div class="ht-stat-index">02</div>
            <div class="ht-stat-value">@Model.TotalCaloriesBurned.ToString("N0")</div>
            <div class="ht-stat-label">Calories burned</div>
        </div>
        <div class="ht-card ht-stat">
            <div class="ht-stat-index">03</div>
            <div class="ht-stat-value">@(Model.ActiveClients)<span style="font-size:1.6rem;color:var(--ht-text-faint)"> / @(Model.ClientCount)</span></div>
            <div class="ht-stat-label">Active clients</div>
        </div>
        <div class="ht-card ht-stat">
            <div class="ht-stat-index">04</div>
            <div class="ht-stat-value">@Model.CompletedAppointments</div>
            <div class="ht-stat-label">Sessions completed</div>
        </div>
    </div>

    <section class="ht-card" style="margin-bottom:20px">
        <div class="ht-card-head">
            <h2 class="ht-card-title">Workouts logged per week</h2>
            <span class="ht-mono">Last 8 weeks</span>
        </div>
        <div class="ht-chart">
            @foreach (var w in Model.Weeks)
            {
                <div class="ht-chart-col">
                    <div class="ht-chart-barwrap"><div class="ht-chart-bar" style="height:@(w.Pct)%"></div></div>
                    <div class="ht-chart-val">@w.Count</div>
                    <div class="ht-chart-lbl">@w.Label</div>
                </div>
            }
        </div>
    </section>

    <section class="ht-card">
        <div class="ht-card-head"><h2 class="ht-card-title">By client</h2></div>
        @if (Model.Rows.Any())
        {
            <div class="ht-table-wrap">
                <table class="ht-table">
                    <thead>
                        <tr><th>Client</th><th>Workouts</th><th>Burned</th><th>Avg kcal eaten / day</th><th>Weight change</th><th>Last activity</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td data-label="Client"><div class="ht-name"><span class="ht-avatar">@r.Initials</span>@r.ClientName</div></td>
                                <td data-label="Workouts">
                                    <div style="display:flex;align-items:center;gap:12px">
                                        <b>@r.Workouts</b>
                                        <div class="ht-meter"><span style="width:@(r.Pct)%"></span></div>
                                    </div>
                                </td>
                                <td data-label="Burned">@r.CaloriesBurned.ToString("N0")</td>
                                <td data-label="Avg kcal eaten / day">@(r.AvgCaloriesIn.HasValue ? r.AvgCaloriesIn.Value.ToString("N0") : "—")</td>
                                <td data-label="Weight change">@(r.WeightChange.HasValue ? (r.WeightChange.Value > 0 ? "+" : "") + r.WeightChange.Value.ToString("0.#") + " kg" : "—")</td>
                                <td data-label="Last activity">@(r.LastActivity.HasValue ? r.LastActivity.Value.ToString("d MMM yyyy") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ht-empty"><div>Add clients to see their progress here.</div></div>
        }
    </section>
</div>
