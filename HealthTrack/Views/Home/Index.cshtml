    .hx-switch-panel{padding:20px 0;min-height:122px}.hx-switch-panel h3{font-size:25px;letter-spacing:-.05em;text-transform:uppercase;margin:0 0 10px}.hx-switch-panel p{font-size:14px;color:var(--stone);line-height:1.6;max-width:460px;margin:0}
    .hx-process{background:var(--ivory);color:var(--ink)}.hx-process .hx-mono{color:#454144}.hx-process .hx-inner{padding-bottom:85px}.hx-process .hx-head{font-size:clamp(65px,9vw,140px)}.hx-process .hx-head em{color:var(--wine)}
    .hx-steps{list-style:none;padding:0;margin:35px 0 0;max-width:1150px}.hx-steps li{display:grid;grid-template-columns:58px minmax(0,1fr) minmax(0,1.15fr);gap:22px;border-top:1px solid #b6afaa;padding:20px 0;align-items:start}
