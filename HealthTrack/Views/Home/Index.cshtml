    .hx-door strong{font:900 clamp(28px,4.4vw,72px)/.95 var(--sans);text-transform:uppercase;letter-spacing:-.065em;display:flex;justify-content:space-between;gap:15px}.hx-door strong span{transition:transform .25s}.hx-door:hover strong span{transform:translate(6px,-4px)}.hx-door small{display:block;font:500 11px/1.6 var(--mono);color:var(--stone);margin-top:14px;text-transform:uppercase}
    [data-reveal]{opacity:0;transform:translateY(35px);transition:opacity .9s cubic-bezier(.22,1,.36,1),transform .9s cubic-bezier(.22,1,.36,1)}[data-reveal].is-visible{opacity:1;transform:none}
    @@media(max-width:1050px){.hx-stack{height:auto;min-height:100svh;position:relative;overflow:visible}.hx-inner{min-height:100svh}.hx-head{font-size:clamp(65px,11vw,115px)}.hx-intro-grid{grid-template-columns:1fr}.hx-dual{min-height:260px}.hx-plan .hx-inner,.hx-question .hx-inner{grid-template-columns:1fr 1fr;gap:35px}.hx-portrait{min-height:510px}.hx-session{height:auto}.hx-session-sticky{height:auto;min-height:100svh;position:relative}.hx-stage{grid-template-columns:1fr 30px 1fr}.hx-session-line:before{transform:scaleX(1)}.hx-stage-panel[data-role="trainer"] .hx-row{opacity:1;transform:none}}
    @@media(max-width:700px){.hx-inner{padding:108px 20px 62px;min-height:auto}.hx-hero .hx-inner{min-height:100svh}.hx-hero-title{font-size:clamp(70px,15vw,130px)}.hx-hero-title em{padding-left:8%}.hx-hero-bottom{align-items:flex-start;flex-direction:column}.hx-buttons{width:100%}.hx-cta{flex:1;min-width:0;gap:10px}.hx-hero-media img{object-position:70% center}.hx-hero:after{background:linear-gradient(90deg,rgba(13,14,16,.8),rgba(13,14,16,.25)),linear-gradient(0deg,#0D0E10,transparent 65%)}.hx-underhero{margin-top:20px}.hx-head{font-size:clamp(61px,13.5vw,100px)}.hx-dual,.hx-plan .hx-inner,.hx-question .hx-inner,.hx-doors{grid-template-columns:1fr}.hx-dual article{min-height:270px}.hx-portrait{min-height:430px}.hx-stage{grid-template-columns:1fr;gap:12px}.hx-session-line{min-height:20px}.hx-session-line:before{width:1px;height:20px}.hx-note{right:0;max-width:85%}.hx-steps li{grid-template-columns:42px 1fr}.hx-steps p{grid-column:2}.hx-process .hx-head{font-size:clamp(54px,11vw,90px)}}
    @@media(max-width:430px){.hx-hero-title{font-size:16vw}.hx-cta{flex-basis:100%}.hx-session .hx-head{font-size:15vw}.hx-head{font-size:14vw}}
    @@media(prefers-reduced-motion:reduce){.hx-stack{position:relative;height:auto;min-height:auto;overflow:visible}[data-reveal]{opacity:1;transform:none}.hx-hero-media img{transform:none}.hx-dual article:hover img{transform:none}}

    .hx-hero{position:sticky;isolation:isolate;background-color:#0D0E10}
    .hx-hero-media{position:absolute;inset:0;z-index:0;width:100%;height:100%;overflow:hidden;pointer-events:none}
    .hx-hero-media .hx-hero-img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:62% center;opacity:1;visibility:visible}
    .hx-hero::after{z-index:1}
    .hx-hero > .hx-inner{position:relative;z-index:2}
    @@media(max-width:1050px){.hx-hero{position:relative}}
    @@media(max-width:700px){.hx-hero-media .hx-hero-img{object-position:70% center}}
</style>
}
<div class="hx">
<section class="hx-chapter hx-stack hx-hero" id="opening" aria-labelledby="hero-title">
    <div class="hx-hero-media">
        <img class="hx-hero-img" src="@Url.Content("~/Content/img/landing/hero-coaching.jpg")" alt="Personal trainer helping an athlete prepare for a kettlebell exercise" fetchpriority="high" decoding="async" />
    </div>
    <div class="hx-inner">
        <div><div class="hx-mono hx-label">00 / FOR THE PEOPLE WHO TRAIN AND THE PEOPLE WHO COACH</div><h1 class="hx-hero-title" id="hero-title"><span>THE WORK.</span><em>has two</em><span>SIDES.</span></h1></div>
        <div><div class="hx-hero-bottom"><p class="hx-deck">For the one putting in the work. And the one who makes every session count.</p><div class="hx-buttons"><a class="hx-cta" href="@registerClient">Start training <span aria-hidden="true">↗</span></a><a class="hx-cta" href="@registerTrainer">Start coaching <span aria-hidden="true">↗</span></a></div></div><div class="hx-underhero"><span class="hx-mono">ONE PLATFORM / TWO PERSPECTIVES</span><a href="#perspectives">SCROLL TO DISCOVER ↓</a></div></div>
    </div>
</section>
<section class="hx-chapter hx-stack hx-intro" id="perspectives" aria-labelledby="perspectives-title">
    <div class="hx-inner"><div><span class="hx-mono hx-label">01 / THE PLATFORM</span><div class="hx-intro-grid"><h2 class="hx-head" id="perspectives-title" data-reveal><span>ONE</span><em>shared</em><span>PURPOSE.</span></h2><p class="hx-intro-copy" data-reveal>A plan written with intention. A session recorded with honesty. A clearer picture of what comes next.</p></div></div><div class="hx-dual"><article><img src="@(assets + "athlete-detail.jpg")" alt="Athlete preparing to train" loading="lazy" /><span class="hx-mono">01 / THE CLIENT</span><div><h3>DO THE WORK.</h3><p>Training and nutrition plans, logs and progress in one place.</p></div></article><article><img src="@(assets + "trainer-detail.jpg")" alt="Personal trainer supervising a session" loading="lazy" /><span class="hx-mono">02 / THE TRAINER</span><div><h3>GUIDE THE WORK.</h3><p>Structure a programme and support the people following it.</p></div></article></div></div>
</section>
<section class="hx-chapter hx-stack hx-plan" id="plan" aria-labelledby="plan-title">
    <div class="hx-inner"><div class="hx-portrait"><img src="@(assets + "coaching-editorial.jpg")" alt="Trainer and athlete focused on a strength exercise" loading="lazy"/><span class="hx-portrait-tag">02 / COACHING IS PERSONAL</span></div><div><span class="hx-mono hx-label">02 / THE PLAN</span><h2 class="hx-head" id="plan-title" data-reveal><span>WRITTEN.</span><em>for one</em><span>PERSON.</span></h2><p class="hx-copy">The trainer sets the direction. The client knows what to do next.</p><div class="hx-ui" aria-label="Illustrative training plan"><header><span>STRENGTH / SAMPLE PLAN</span><span>04 WEEKS</span></header><div class="hx-row"><strong>Monday / Lower body</strong><span>04 exercises</span></div><div class="hx-row"><strong>Wednesday / Upper body</strong><span>05 exercises</span></div><div class="hx-row"><strong>Friday / Full body</strong><span>04 exercises</span></div><div class="hx-caption" style="padding-top:15px">Illustrative sample / Not a live account</div></div></div></div>
</section>
<section class="hx-chapter hx-session" id="session" aria-labelledby="session-title">
    <div class="hx-session-sticky"><span class="hx-mono hx-label">03 / THE CONNECTION / SCROLL TO FOLLOW THE RECORD</span><h2 class="hx-head" id="session-title"><span>LOGGED.</span><em>and then</em><span>SEEN.</span></h2><div class="hx-stage"><div class="hx-stage-panel" data-role="client"><div><span class="hx-mono">CLIENT / WORKOUT LOG / SAMPLE</span><h3>THE SESSION.</h3></div><div><div class="hx-row"><strong>Back squat</strong><span>4 × 8</span></div><div class="hx-row"><strong>Rowing</strong><span>20 minutes</span></div><div class="hx-row"><strong>Status</strong><span class="hx-session-status" id="client-status">READY TO SAVE</span></div></div></div><div class="hx-session-line" aria-hidden="true"></div><div class="hx-stage-panel" data-role="trainer" id="trainer-stage"><div><span class="hx-mono">TRAINER / CLIENT ACTIVITY / SAMPLE</span><h3>THE PICTURE.</h3></div><div><div class="hx-row"><strong>Last activity</strong><span id="trainer-latest">—</span></div><div class="hx-row"><strong>Sessions logged</strong><span id="trainer-sessions">02</span></div><div class="hx-row"><strong>Review</strong><span class="hx-session-status" id="trainer-review">AWAITING ENTRY</span></div></div></div></div><div class="hx-scrub" aria-hidden="true"><span id="session-meter"></span></div><p class="hx-caption">Illustrative connection of Client and Trainer workflows. Exact report presentation subject to integration testing.</p></div>
</section>
<section class="hx-chapter hx-stack hx-question" id="question" aria-labelledby="question-title"><div class="hx-inner"><div><span class="hx-mono hx-label">04 / THE CONVERSATION</span><h2 class="hx-head" id="question-title" data-reveal><span>ASKED.</span><em>and</em><span>ANSWERED.</span></h2><p class="hx-copy">Not another chat window. A clear request, the right context and a considered reply.</p><div class="hx-perspective"><div class="hx-switch" role="group" aria-label="Explore both sides of a trainer request"><button type="button" id="view-client" aria-pressed="true">Client perspective</button><button type="button" id="view-trainer" aria-pressed="false">Trainer perspective</button></div><div class="hx-switch-panel" id="perspective-panel" aria-live="polite"><h3>Ask for an adjustment.</h3><p>Category: Plan adjustment · Priority: Normal · “Could we move Friday's workout to Saturday?”</p></div><span class="hx-caption">Demonstration / Trainer Requests feature awaiting integration testing</span></div></div><div class="hx-question-visual"><img src="@(assets + "trainer-detail.jpg")" alt="Trainer observing an athlete and considering a session adjustment" loading="lazy"/><div class="hx-note"><span class="hx-mono">A REQUEST / A RESPONSE</span><p>“A better plan starts with a better conversation.”</p><span class="hx-caption" style="color:#454044">HealthTrack / Coaching in context</span></div></div></div></section>
<section class="hx-chapter hx-stack hx-process" id="process" aria-labelledby="process-title"><div class="hx-inner"><span class="hx-mono hx-label">05 / THE PROCESS</span><h2 class="hx-head" id="process-title" data-reveal><span>FIVE STEPS.</span><em>Two</em><span>SIDES.</span></h2><ol class="hx-steps"><li><span class="hx-step-number">01</span><strong>Register.</strong><p>Create an account as a client or a trainer.</p></li><li><span class="hx-step-number">02</span><strong>Connect.</strong><p>Build a client–trainer relationship. The new selection approval workflow awaits integrated testing.</p></li><li><span class="hx-step-number">03</span><strong>Plan.</strong><p>Trainers design training and nutrition programmes for clients.</p></li><li><span class="hx-step-number">04</span><strong>Train.</strong><p>Clients record activities, meals and measurements; trainers manage sessions.</p></li><li><span class="hx-step-number">05</span><strong>Adjust.</strong><p>Review progress, share requests and refine the plan over time.</p></li></ol></div></section>
<section class="hx-chapter hx-stack hx-invite" id="join" aria-labelledby="invite-title"><div class="hx-inner"><div><span class="hx-mono hx-label">06 / THE INVITATION</span><h2 class="hx-head" id="invite-title" data-reveal><span>CHOOSE.</span><em>your</em><span>SIDE.</span></h2><p class="hx-copy">Two different roles. One better way to move forward.</p></div><div><div class="hx-doors"><a class="hx-door" href="@registerClient"><strong>START TRAINING <span aria-hidden="true">↗</span></strong><small>For clients / Your training, nutrition and progress</small></a><a class="hx-door" href="@registerTrainer"><strong>START COACHING <span aria-hidden="true">↗</span></strong><small>For trainers / Your clients, plans and sessions</small></a></div><p class="hx-caption" style="margin-top:40px">Already a member? <a href="@Url.Action("Login","Account")">Log in ↗</a></p></div></div></section>
</div>
@section scripts {
<script>
(function () {
    'use strict';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var reveals = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window && !reduce) {
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
        }, { threshold: 0.1 });
        reveals.forEach(function (el) { observer.observe(el); });
    } else { reveals.forEach(function (el) { el.classList.add('is-visible'); }); }
    var clientButton = document.getElementById('view-client');
    var trainerButton = document.getElementById('view-trainer');
    var panel = document.getElementById('perspective-panel');
    function showPerspective(trainer) {
        clientButton.setAttribute('aria-pressed', trainer ? 'false' : 'true');
        trainerButton.setAttribute('aria-pressed', trainer ? 'true' : 'false');
        panel.innerHTML = trainer
            ? '<h3>Respond with context.</h3><p>Request: Plan adjustment · Status: Answered · “Yes, we can move that session and keep your recovery time between workouts.”</p>'
            : '<h3>Ask for an adjustment.</h3><p>Category: Plan adjustment · Priority: Normal · “Could we move Friday’s workout to Saturday?”</p>';
    }
    clientButton.addEventListener('click', function () { showPerspective(false); });
    trainerButton.addEventListener('click', function () { showPerspective(true); });
    var progress = document.getElementById('hl-progress');
    var track = document.getElementById('session');
    var stage = document.getElementById('trainer-stage');
    var clientStatus = document.getElementById('client-status');
    var latest = document.getElementById('trainer-latest');
    var sessions = document.getElementById('trainer-sessions');
    var review = document.getElementById('trainer-review');
    var meter = document.getElementById('session-meter');
    var raf = false;
    function clamp(v) { return Math.max(0, Math.min(1, v)); }
    function render() {
        var available = document.documentElement.scrollHeight - window.innerHeight;
        var pct = available > 0 ? clamp(window.scrollY / available) : 0;
        if (progress) progress.style.transform = 'scaleX(' + pct + ')';
        if (track) {
            var length = track.offsetHeight - window.innerHeight;
            var p = length > 0 ? clamp(-track.getBoundingClientRect().top / length) : (track.getBoundingClientRect().top <= 0 ? 1 : 0);
            if (reduce || window.innerWidth <= 1050) { p = track.getBoundingClientRect().top < window.innerHeight * .7 ? 1 : 0; }
            meter.style.width = (p * 100) + '%';
            track.style.setProperty('--handover', clamp((p - .42) / .24));
            var saved = p > .32;
            var shared = p > .69;
            clientStatus.textContent = saved ? 'LOGGED' : 'READY TO SAVE';
            latest.textContent = shared ? 'Strength' : '—';
            sessions.textContent = shared ? '03' : '02';
            review.textContent = shared ? 'AVAILABLE TO REVIEW' : 'AWAITING ENTRY';
            stage.classList.toggle('is-complete', shared);
        }
        raf = false;
    }
    window.addEventListener('scroll', function () { if (!raf) { raf = true; requestAnimationFrame(render); } }, { passive:true });
    window.addEventListener('resize', function () { if (!raf) { raf = true; requestAnimationFrame(render); } });
    render();
})();
</script>
}
