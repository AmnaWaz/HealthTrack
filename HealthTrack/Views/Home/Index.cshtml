@{
    ViewBag.Title = "Both sides of the work";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var registerClient = Url.Action("Register", "Account", new { role = "Client" });
    var registerTrainer = Url.Action("Register", "Account", new { role = "Trainer" });
    var assets = Url.Content("~/Content/img/landing/");
}
@section styles {
<style>
