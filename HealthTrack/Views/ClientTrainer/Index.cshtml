

@model HealthTrack.ViewModels.ClientTrainerViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "My Trainer";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var workoutPlans = Model.RecentPlans
        .Where(p => p.PlanType == "Workout")
        .ToList();

    var dietPlans = Model.RecentPlans
        .Where(p => p.PlanType == "Diet")
        .ToList();
}

<style>
    .cmt-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 28px 14px 70px;
    }

    .cmt-eyebrow {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .cmt-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 32px;
    }

        .cmt-header h1 {
            font: 700 clamp(40px, 5vw, 68px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin: 8px 0;
        }

    .cmt-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .cmt-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border: 1px solid #b6505d;
        background: #b6505d;
        color: #fff;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        text-decoration: none;
    }

        .cmt-button:hover {
            background: #913e49;
            color: #fff;
        }

    .cmt-button-outline {
        background: transparent;
        border-color: #a5aab2;
        color: inherit;
    }

        .cmt-button-outline:hover {
            background: transparent;
            color: #b6505d;
            border-color: #b6505d;
        }

    .cmt-section {
        margin-top: 40px;
    }

    .cmt-section-heading {
        margin-bottom: 18px;
    }

        .cmt-section-heading h2 {
            font: 700 28px "Archivo Narrow", sans-serif;
            margin: 7px 0 0;
            text-transform: uppercase;
        }

    .cmt-panel {
        padding: 24px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
        min-width: 0;
    }

    .cmt-profile {
        display: grid;
        grid-template-columns: 100px minmax(0, 1fr);
        gap: 26px;
        align-items: start;
    }

    .cmt-avatar {
        width: 100px;
        height: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #15263b;
        color: #fff;
        font: 700 45px "Archivo Narrow", sans-serif;
    }

    .cmt-profile h2 {
        font: 700 42px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        margin: 7px 0 14px;
    }

    .cmt-bio {
        max-width: 740px;
        line-height: 1.8;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 14px;
        margin: 0;
    }

    .cmt-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }

    .cmt-tag {
        padding: 9px 12px;
        border: 1px solid var(--ht-border, #a5aab2);
        font: 600 11px "IBM Plex Mono", monospace;
    }

    .cmt-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        background: #bfc1c5;
        border: 1px solid #bfc1c5;
        margin-top: 22px;
    }

    .cmt-stat {
        background: var(--ht-surface, #f4f0e8);
        padding: 22px;
    }

        .cmt-stat span {
            display: block;
            font: 600 10px "IBM Plex Mono", monospace;
            color: #858d99;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .cmt-stat strong {
            font: 700 36px "Archivo Narrow", sans-serif;
        }

    .cmt-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .cmt-card h3 {
        font: 700 24px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        margin: 8px 0 12px;
    }

    .cmt-record {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 17px 0;
        border-top: 1px solid var(--ht-border, #b9bdc2);
    }

        .cmt-record strong {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
        }

        .cmt-record small {
            display: block;
            color: #858d99;
            font-size: 12px;
            line-height: 1.6;
        }

    .cmt-status {
        border: 1px solid #a5aab2;
        padding: 6px 9px;
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cmt-status-active {
        color: #65967c;
        border-color: #65967c;
    }

    .cmt-status-upcoming {
        color: #b58b58;
        border-color: #b58b58;
    }

    .cmt-link {
        display: inline-block;
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        text-decoration: none;
        margin-top: 16px;
    }

        .cmt-link:hover {
            text-decoration: underline;
        }

    .cmt-request-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin: 20px 0;
    }

    .cmt-request-type {
        padding: 17px;
        border: 1px solid var(--ht-border, #b9bdc2);
    }

        .cmt-request-type strong {
            display: block;
            font: 700 17px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .cmt-request-type span {
            font-size: 12px;
            color: #858d99;
        }

    .cmt-notice {
        border-left: 3px solid #b6505d;
        padding: 14px 17px;
        background: rgba(182, 80, 93, .07);
        font-size: 12px;
        line-height: 1.7;
        margin-top: 18px;
    }

    .cmt-empty {
        padding: 45px 25px;
        border: 1px dashed #a5aab2;
        text-align: center;
    }

        .cmt-empty h2 {
            font: 700 28px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

    @@media (max-width: 850px) {
        .cmt-grid {
            grid-template-columns: 1fr;
        }

        .cmt-request-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 580px) {
        .cmt-header {
            flex-direction: column;
            align-items: stretch;
        }

        .cmt-profile {
            grid-template-columns: 1fr;
        }

        .cmt-avatar {
            width: 75px;
            height: 75px;
            font-size: 32px;
        }

        .cmt-profile h2 {
            font-size: 32px;
        }

        .cmt-stats {
            grid-template-columns: 1fr;
        }

        .cmt-request-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cmt-page">
    <header class="cmt-header">
        <div>
            <span class="cmt-eyebrow">06 / CLIENT WORKSPACE</span>
            <h1>MY TRAINER</h1>
            <p class="cmt-muted">
                Your assigned trainer, personalized plans and consultations.
            </p>
        </div>

        <a class="cmt-button cmt-button-outline"
           href="@Url.Action("Index", "ClientTrainerDirectory")">
            FIND A TRAINER
        </a>
    </header>

    @if (!Model.HasAssignedTrainer)
    {
        <div class="cmt-empty">
            <span class="cmt-eyebrow">TRAINER ASSIGNMENT</span>
            <h2>NO TRAINER ASSIGNED YET</h2>

            <p class="cmt-muted">
                Your trainer's details will appear here once you're assigned.
                You can continue logging workouts, meals and measurements.
            </p>

            <a class="cmt-button"
               href="@Url.Action("Index", "ClientTrainerDirectory")">
                BROWSE TRAINERS
            </a>
            <a class="cmt-button cmt-button-outline"
               href="@Url.Action("Overview", "Client")">
                RETURN TO OVERVIEW
            </a>
        </div>
    }
    else
    {
        <section class="cmt-section">
            <div class="cmt-panel cmt-profile">
                <div class="cmt-avatar">
                    @if (!string.IsNullOrWhiteSpace(Model.TrainerPhotoPath))
                    {
                        <img src="@Url.Content("~" + Model.TrainerPhotoPath)"
                             alt="@Model.TrainerName profile photo"
                             style="width:100%;height:100%;object-fit:cover;display:block"
                             loading="lazy" />
                    }
                    else
                    {
                        <span aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.TrainerName) ? "T" : Model.TrainerName.Substring(0, 1).ToUpperInvariant())</span>
                    }
                </div>

                <div>
                    <span class="cmt-eyebrow">YOUR ASSIGNED TRAINER</span>

                    <h2>@Model.TrainerName</h2>
                    @if (Model.TrainerAverageRating > 0)
                    {
                        <p class="cmt-muted" style="margin:0 0 12px">Trainer rating: @Model.TrainerAverageRating.ToString("0.0") / 5</p>
                    }

                    <p class="cmt-bio">
                        @(string.IsNullOrWhiteSpace(Model.TrainerBio)
                        ? "Your trainer has not added a biography yet."
                        : Model.TrainerBio)
                    </p>

                    @if (Model.Specialisations.Any())
                    {
                        <div class="cmt-tags">
                            @foreach (var specialisation in Model.Specialisations)
                            {
                                <span class="cmt-tag">@specialisation</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="cmt-muted" style="margin-top:16px">
                            No specialisations listed.
                        </p>
                    }
                </div>
            </div>

            <div class="cmt-stats">
                <div class="cmt-stat">
                    <span>Active workout plans</span>
                    <strong>@Model.ActiveWorkoutPlans</strong>
                </div>

                <div class="cmt-stat">
                    <span>Active diet plans</span>
                    <strong>@Model.ActiveDietPlans</strong>
                </div>

                <div class="cmt-stat">
                    <span>Upcoming sessions</span>
                    <strong>@Model.UpcomingAppointments</strong>
                </div>
            </div>
        </section>

        <section class="cmt-section">
            <div class="cmt-section-heading">
                <span class="cmt-eyebrow">01 / ASSIGNED PROGRAMS</span>
                <h2>YOUR PLANS</h2>
            </div>

            <div class="cmt-grid">
                <article class="cmt-panel cmt-card">
                    <span class="cmt-eyebrow">TRAINING</span>
                    <h3>WORKOUT PLANS</h3>

                    @if (workoutPlans.Any())
                    {
                        foreach (var plan in workoutPlans)
                        {
                            <div class="cmt-record">
                                <div>
                                    <strong>@plan.PlanName</strong>
                                    <small>
                                        @plan.StartDate.ToString("dd MMM yyyy")
                                        —
                                        @plan.EndDate.ToString("dd MMM yyyy")
                                    </small>
                                </div>

                                <span class="cmt-status @(plan.Status == "Active" ? "cmt-status-active" : plan.Status == "Upcoming" ? "cmt-status-upcoming" : "")">
                                    @plan.Status
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="cmt-muted">
                            No recent workout plans from your assigned trainer.
                        </p>
                    }

                    <a class="cmt-link"
                       href="@Url.Action("Index", "ClientTraining")">
                        VIEW ALL WORKOUT PLANS →
                    </a>
                </article>

                <article class="cmt-panel cmt-card">
                    <span class="cmt-eyebrow">NUTRITION</span>
                    <h3>DIET PLANS</h3>

                    @if (dietPlans.Any())
                    {
                        foreach (var plan in dietPlans)
                        {
                            <div class="cmt-record">
                                <div>
                                    <strong>@plan.PlanName</strong>
                                    <small>
                                        @plan.StartDate.ToString("dd MMM yyyy")
                                        —
                                        @plan.EndDate.ToString("dd MMM yyyy")
                                    </small>
                                </div>

                                <span class="cmt-status @(plan.Status == "Active" ? "cmt-status-active" : plan.Status == "Upcoming" ? "cmt-status-upcoming" : "")">
                                    @plan.Status
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="cmt-muted">
                            No recent diet plans from your assigned trainer.
                        </p>
                    }

                    <a class="cmt-link"
                       href="@Url.Action("Index", "ClientNutrition")">
                        VIEW ALL DIET PLANS →
                    </a>
                </article>
            </div>
        </section>

        <section class="cmt-section">
            <div class="cmt-section-heading">
                <span class="cmt-eyebrow">02 / CONSULTATIONS</span>
                <h2>UPCOMING SESSIONS</h2>
            </div>

            <div class="cmt-panel">
                @if (Model.UpcomingSessions.Any())
                {
                    foreach (var session in Model.UpcomingSessions)
                    {
                        <div class="cmt-record">
                            <div>
                                <strong>
                                    @session.AppointmentDateTime.ToString("dddd, dd MMM yyyy")
                                </strong>

                                <small>
                                    @session.AppointmentDateTime.ToString("hh:mm tt")
                                    @if (!string.IsNullOrWhiteSpace(session.Location))
                                    {
                                        <span> · @session.Location</span>
                                    }
                                </small>
                            </div>

                            <span class="cmt-status cmt-status-active">
                                @session.Status
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="cmt-muted">
                        No upcoming consultations with your assigned trainer.
                    </p>
                }

                <a class="cmt-link"
                   href="@Url.Action("Index", "ClientSessions")">
                    VIEW ALL SESSIONS →
                </a>
            </div>
        </section>

        <section class="cmt-section" id="trainerRequests">
            <div class="cmt-section-heading">
                <span class="cmt-eyebrow">03 / SUPPORT &amp; COMMUNICATION</span>
                <h2>TRAINER REQUESTS</h2>
            </div>

            <div class="cmt-panel">
                <h3 style="font:700 26px 'Archivo Narrow',sans-serif;text-transform:uppercase;margin-bottom:10px">
                    COMMUNICATE YOUR NEEDS
                </h3>

                <p class="cmt-muted">
                    Request adjustments to your fitness plans or inform your
                    trainer about concerns that could affect your training.
                </p>

                <div class="cmt-request-grid">
                    <div class="cmt-request-type">
                        <strong>Medical concern</strong>
                        <span>Injuries or health-related limitations</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>Workout difficulty</strong>
                        <span>Exercises that are too difficult</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>Dietary concern</strong>
                        <span>Allergies or food restrictions</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>Fitness goal</strong>
                        <span>Changes to training objectives</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>Availability</strong>
                        <span>Training schedule limitations</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>Plan adjustment</strong>
                        <span>Workout or diet plan changes</span>
                    </div>

                    <div class="cmt-request-type">
                        <strong>General question</strong>
                        <span>Other questions for your trainer</span>
                    </div>
                </div>

                <div class="cmt-notice">
                    Medical concerns require appropriate professional care.
                    Your trainer can consider relevant limitations when
                    planning workouts but cannot diagnose conditions or
                    provide medical treatment. This feature is not monitored
                    for emergencies.
                </div>

                <a class="cmt-button"
                   href="@Url.Action("Index", "ClientTrainerRequests")">
                    OPEN TRAINER REQUESTS
                </a>
            </div>
        </section>
    }
</div>
