@model HealthTrack.ViewModels.OnboardingDoneViewModel
@* Success state after onboarding (Person A). Continues to the dashboard automatically after a
   short, visible countdown that the user can stop (WCAG 2.2.1 "Timing adjustable"). *@
@{
    Layout = "~/Views/Shared/_OnboardingLayout.cshtml";
    ViewBag.Title = "You're all set";
    var isClient = Model.Role == "Client";
}

<div class="ob-shell is-done">
    <aside class="ob-aside" aria-label="Profile set-up progress">
        <div class="ob-aside-top">
            <span class="ht-brand">@Html.Partial("_Brand")</span>
            <div class="ob-tools">
                <button type="button" class="ht-theme-toggle" data-theme-toggle aria-label="Switch light / dark theme" title="Switch light / dark theme">
                    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
                </button>
            </div>
        </div>
        <div class="ob-aside-body">
            <p class="ht-eyebrow">Profile complete &middot; @Model.Role</p>
            <p class="ob-aside-title">First round:<br />done.</p>
        </div>
    </aside>

    <main class="ob-main" id="ob-main">
        <div class="ob-panel ob-done">
            <div class="ob-progress" aria-hidden="true"><span style="width:100%"></span></div>
            <div class="ob-done-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </div>
            <h1 class="ob-title" tabindex="-1" data-ob-heading>You&rsquo;re all set, @Model.FirstName.</h1>
            <p class="ob-intro">
                @(isClient
                    ? "Your profile is ready. Your trainer will use your goals to build your workout and diet plans."
                    : "Your trainer profile is ready. Clients can now see what you coach.")
            </p>

            @if (Model.Chips.Count > 0)
            {
                <p class="auth-label">@(isClient ? "Your goals" : "Your specialisations")</p>
                <ul class="op-chips is-static">
                    @foreach (var c in Model.Chips)
                    {<li class="op-chip"><span class="op-chip-text">@c</span></li>}
                </ul>
            }

            <a class="auth-btn ob-next" href="@Model.DashboardUrl" data-ob-continue>
                @(isClient ? "Go to my plans" : "Go to my dashboard")
            </a>
            <p class="ob-countdown" data-ob-countdown data-url="@Model.DashboardUrl" data-seconds="6" aria-live="polite">
                <span data-ob-countdown-text>Taking you there automatically&hellip;</span>
                <button type="button" class="ob-link-btn" data-ob-countdown-stop>Stay on this page</button>
            </p>
        </div>
    </main>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/onboarding.js")"></script>
}
