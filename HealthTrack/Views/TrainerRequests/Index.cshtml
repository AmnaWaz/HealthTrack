
@model HealthTrack.ViewModels.TrainerRequestsViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Trainer Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var filters = new[]
    {
        new { Value = "all", Label = "All Requests" },
        new { Value = "open", Label = "Open" },
        new { Value = "review", Label = "In Review" },
        new { Value = "answered", Label = "Answered" },
        new { Value = "closed", Label = "Closed" }
    };
}

<style>
    .tri-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 18px 80px;
    }

    .tri-eyebrow {
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .tri-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 30px;
    }

        .tri-header h1 {
            font: 700 clamp(36px, 5vw, 60px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
            margin: 8px 0;
        }

    .tri-muted {
        color: #858d99;
        font-size: 13px;
        line-height: 1.7;
    }

    .tri-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        background: #b6505d;
        border: 1px solid #b6505d;
        color: white;
        font: 600 11px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
    }

        .tri-button:hover {
            background: #963f4a;
            color: white;
        }

    .tri-button-outline {
        background: transparent;
        border-color: #aeb3ba;
        color: inherit;
    }

        .tri-button-outline:hover {
            background: transparent;
            border-color: #b6505d;
            color: #b6505d;
        }

    .tri-button-small {
        padding: 9px 13px;
        font-size: 10px;
    }

    .tri-stats {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 26px;
    }

    .tri-stat {
        padding: 20px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
        min-width: 0;
    }

        .tri-stat span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            margin-bottom: 12px;
            line-height: 1.6;
        }

        .tri-stat strong {
            font: 700 35px "Archivo Narrow", sans-serif;
        }

    .tri-stat-high {
        border-color: #b6505d;
    }

    .tri-stat-urgent {
        border-color: #b58c55;
    }

    .tri-alert {
        padding: 15px 18px;
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .1);
        margin-bottom: 20px;
        font-size: 13px;
    }

    .tri-alert-error {
        border-color: #b6505d;
        background: rgba(182, 80, 93, .09);
    }

    .tri-safety {
        padding: 16px 19px;
        border-left: 4px solid #b58c55;
        background: rgba(181, 140, 85, .09);
        margin-bottom: 24px;
    }

        .tri-safety strong {
            display: block;
            margin-bottom: 7px;
            font: 700 16px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

        .tri-safety p {
            margin: 0;
            font-size: 12px;
            line-height: 1.8;
        }

    .tri-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 25px;
    }

    .tri-filter {
        display: inline-flex;
        padding: 11px 14px;
        text-decoration: none;
        text-transform: uppercase;
        font: 600 10px "IBM Plex Mono", monospace;
        border: 1px solid var(--ht-border, #b9bdc2);
        color: inherit;
    }

        .tri-filter:hover {
            border-color: #b6505d;
            color: #b6505d;
            text-decoration: none;
        }

        .tri-filter.active {
            background: #b6505d;
            border-color: #b6505d;
            color: white;
        }

    .tri-section-title {
        font: 700 29px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        margin: 8px 0 20px;
    }

    .tri-list {
        display: grid;
        gap: 18px;
    }

    .tri-card {
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
        padding: 24px;
        min-width: 0;
    }

    .tri-card-high {
        border-left: 4px solid #b6505d;
    }

    .tri-card-urgent {
        border-left: 4px solid #b58c55;
    }

    .tri-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 18px;
    }

    .tri-card h3 {
        font: 700 28px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }

    .tri-tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 14px 0;
    }

    .tri-tag {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border: 1px solid var(--ht-border, #b9bdc2);
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
    }

    .tri-tag-high {
        color: #b6505d;
        border-color: #b6505d;
    }

    .tri-tag-urgent {
        color: #b58c55;
        border-color: #b58c55;
    }

    .tri-tag-review {
        color: #b58c55;
        border-color: #b58c55;
    }

    .tri-tag-answered {
        color: #65967c;
        border-color: #65967c;
    }

    .tri-tag-closed {
        opacity: .65;
    }

    .tri-detail {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
        margin: 20px 0;
    }

        .tri-detail span {
            display: block;
            margin-bottom: 6px;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            color: #858d99;
        }

        .tri-detail strong {
            font-size: 13px;
        }

    .tri-description {
        margin: 19px 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 13px;
        line-height: 1.8;
    }

    .tri-analysis {
        padding: 19px;
        margin: 20px 0;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: rgba(127, 127, 127, .045);
    }

    .tri-analysis-urgent {
        border-color: #b58c55;
        background: rgba(181, 140, 85, .07);
    }

    .tri-analysis-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        margin-bottom: 13px;
    }

    .tri-analysis h4 {
        margin: 0;
        font: 700 19px "Archivo Narrow", sans-serif;
        text-transform: uppercase;
    }

    .tri-analysis p {
        margin: 10px 0 0;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .tri-analysis-label {
        display: inline-block;
        margin-top: 12px;
        color: #858d99;
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
    }

    .tri-response {
        padding: 18px;
        border-left: 3px solid #65967c;
        background: rgba(101, 150, 124, .09);
        margin-top: 20px;
    }

        .tri-response h4 {
            margin: 0 0 11px;
            font: 700 18px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

        .tri-response p {
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

    .tri-field {
        margin: 20px 0 14px;
    }

        .tri-field label {
            display: block;
            margin-bottom: 9px;
            font: 600 11px "IBM Plex Mono", monospace;
            text-transform: uppercase;
        }

        .tri-field textarea {
            width: 100%;
            min-height: 120px;
            padding: 13px;
            background: transparent;
            border: 1px solid #aeb3ba;
            color: inherit;
            font-size: 13px;
            line-height: 1.7;
            resize: vertical;
        }

            .tri-field textarea:focus-visible {
                outline: 2px solid #b6505d;
            }

    .tri-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 19px;
    }

        .tri-actions form {
            margin: 0;
        }

    .tri-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 15px;
        align-items: center;
        border-top: 1px solid var(--ht-border, #b9bdc2);
        padding-top: 18px;
        margin-top: 22px;
    }

    .tri-empty {
        border: 1px dashed #aeb3ba;
        padding: 50px 20px;
        text-align: center;
    }

        .tri-empty h3 {
            font: 700 27px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    @@media (max-width: 1150px) {
        .tri-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .tri-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .tri-header,
        .tri-card-head {
            flex-direction: column;
            align-items: stretch;
        }

        .tri-detail {
            grid-template-columns: 1fr;
        }

        .tri-card {
            padding: 18px;
        }
    }
</style>

<div class="tri-page">
    <header class="tri-header">
        <div>
            <span class="tri-eyebrow">TRAINER / CLIENT COMMUNICATION</span>
            <h1>TRAINER REQUESTS</h1>
            <p class="tri-muted">
                Review client concerns, respond to requests and prioritise potentially urgent matters.
            </p>
        </div>

        <a class="tri-button tri-button-outline"
           href="@Url.Action("Index", "Trainer")">
            BACK TO OVERVIEW
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="tri-alert" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="tri-alert" role="status">
            @TempData["Info"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="tri-alert tri-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="tri-stats">
        <div class="tri-stat">
            <span>Total Requests</span>
            <strong>@Model.TotalCount</strong>
        </div>

        <div class="tri-stat">
            <span>Open</span>
            <strong>@Model.OpenCount</strong>
        </div>

        <div class="tri-stat">
            <span>In Review</span>
            <strong>@Model.InReviewCount</strong>
        </div>

        <div class="tri-stat">
            <span>Answered</span>
            <strong>@Model.AnsweredCount</strong>
        </div>

        <div class="tri-stat tri-stat-high">
            <span>Active High Priority</span>
            <strong>@Model.HighPriorityCount</strong>
        </div>

        <div class="tri-stat tri-stat-urgent">
            <span>Urgent Review Flags</span>
            <strong>@Model.UrgentReviewCount</strong>
        </div>
    </div>

    @if (Model.UrgentReviewCount > 0)
    {
        <div class="tri-safety" role="status">
            <strong>
                @Model.UrgentReviewCount REQUEST(S) FLAGGED FOR URGENT REVIEW
            </strong>

            <p>
                These requests contain language that may indicate a health or safety concern.
                Review them promptly. Automated classification may be inaccurate,
                and clients should not rely on this inbox for emergency assistance.
            </p>
        </div>
    }

    <nav class="tri-filters" aria-label="Filter trainer requests">
        @foreach (var filter in filters)
        {
            <a class="tri-filter @(Model.Filter == filter.Value ? "active" : "")"
               href="@Url.Action("Index", "TrainerRequests", new { filter = filter.Value })"
               aria-current="@(Model.Filter == filter.Value ? "page" : null)">
                @filter.Label
            </a>
        }
    </nav>

    <section>
        <span class="tri-eyebrow">01 / REQUEST INBOX</span>
        <h2 class="tri-section-title">CLIENT REQUESTS</h2>

        @if (Model.Requests.Any())
        {
            <div class="tri-list">
                @foreach (var request in Model.Requests)
                {
                    var statusClass = request.Status == "In review"
                        ? "tri-tag-review"
                        : request.Status == "Answered"
                            ? "tri-tag-answered"
                            : request.Status == "Closed"
                                ? "tri-tag-closed"
                                : "";

                    var isActive = request.Status == "Open" ||
                                   request.Status == "In review";

                    var cardClass = isActive && request.RequiresUrgentReview
                        ? "tri-card-urgent"
                        : isActive && request.IsHighPriority
                            ? "tri-card-high"
                            : "";

                    <article class="tri-card @cardClass">
                        <div class="tri-card-head">
                            <div>
                                <span class="tri-eyebrow">
                                    REQUEST #@request.TrainerRequestId
                                </span>

                                <h3>@request.Subject</h3>

                                <p class="tri-muted">
                                    From @request.ClientName
                                </p>
                            </div>

                            <span class="tri-tag @statusClass">
                                @request.Status
                            </span>
                        </div>

                        <div class="tri-tags">
                            <span class="tri-tag">
                                @request.Category
                            </span>

                            <span class="tri-tag @(request.IsHighPriority ? "tri-tag-high" : "")">
                                @request.Priority PRIORITY
                            </span>

                            @if (isActive && request.RequiresUrgentReview)
                            {
                                <span class="tri-tag tri-tag-urgent">
                                    URGENT REVIEW FLAG
                                </span>
                            }
                        </div>

                        <div class="tri-detail">
                            <div>
                                <span>Client</span>
                                <strong>@request.ClientName</strong>
                            </div>

                            <div>
                                <span>Submitted</span>
                                <strong>
                                    @request.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </strong>
                            </div>
                        </div>

                        <span class="tri-eyebrow">CLIENT MESSAGE</span>
                        <p class="tri-description">@request.Description</p>

                        @if (request.HasPriorityAnalysis)
                        {
                            <div class="tri-analysis @(request.RequiresUrgentReview ? "tri-analysis-urgent" : "")">
                                <div class="tri-analysis-head">
                                    <h4>AUTOMATIC PRIORITY ANALYSIS</h4>

                                    <span class="tri-tag @(request.IsHighPriority ? "tri-tag-high" : "")">
                                        @request.AiSuggestedPriority
                                    </span>
                                </div>

                                <p>
                                    @request.AiReason
                                </p>

                                <span class="tri-analysis-label">
                                    Analysis source: @request.AiAnalysisSource
                                </span>

                                @if (request.RequiresUrgentReview)
                                {
                                    <p>
                                        <strong>Human review recommended.</strong>
                                        This flag does not confirm a diagnosis or guarantee an immediate response.
                                    </p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="tri-analysis">
                                <h4>PRIORITY ANALYSIS</h4>
                                <p>
                                    No automatic analysis was recorded for this request.
                                    Review the client's message and selected priority manually.
                                </p>
                            </div>
                        }

                        @if (request.HasResponse)
                        {
                            <div class="tri-response">
                                <h4>YOUR RESPONSE</h4>

                                <p>@request.TrainerResponse</p>

                                @if (request.RespondedAt.HasValue)
                                {
                                    <p class="tri-muted" style="margin-top:10px">
                                        Responded @request.RespondedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    </p>
                                }
                            </div>
                        }

                        @if (request.CanRespond)
                        {
                            using (Html.BeginForm("Respond", "TrainerRequests", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="TrainerRequestId"
                                       value="@request.TrainerRequestId" />

                                <input type="hidden"
                                       name="filter"
                                       value="@Model.Filter" />

                                <div class="tri-field">
                                    <label for="response-@request.TrainerRequestId">
                                        Respond to client
                                    </label>

                                    <textarea id="response-@request.TrainerRequestId"
                                              name="TrainerResponse"
                                              minlength="5"
                                              maxlength="1000"
                                              required
                                              placeholder="Write a helpful response to your client..."></textarea>
                                </div>

                                <button type="submit"
                                        class="tri-button"
                                        onclick="return confirm('Send this response to the client?');">
                                    SEND RESPONSE
                                </button>
                            }
                        }

                        <div class="tri-footer">
                            <div class="tri-muted">
                                Updated @request.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")

                                @if (request.ClosedAt.HasValue)
                                {
                                    <span>
                                        · Closed @request.ClosedAt.Value.ToString("dd MMM yyyy")
                                    </span>
                                }
                            </div>

                            <div class="tri-actions">
                                @if (request.CanReview)
                                {
                                    using (Html.BeginForm("MarkInReview", "TrainerRequests", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.TrainerRequestId" />

                                        <input type="hidden"
                                               name="filter"
                                               value="@Model.Filter" />

                                        <button type="submit"
                                                class="tri-button tri-button-outline tri-button-small">
                                            MARK IN REVIEW
                                        </button>
                                    }
                                }

                                @if (request.CanClose)
                                {
                                    using (Html.BeginForm("Close", "TrainerRequests", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.TrainerRequestId" />

                                        <input type="hidden"
                                               name="filter"
                                               value="@Model.Filter" />

                                        <button type="submit"
                                                class="tri-button tri-button-outline tri-button-small"
                                                onclick="return confirm('Close this request?');">
                                            CLOSE REQUEST
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="tri-empty">
                <h3>NO REQUESTS FOUND</h3>
                <p class="tri-muted">
                    There are no trainer requests matching this filter.
                </p>

                <a class="tri-button tri-button-outline"
                   href="@Url.Action("Index", "TrainerRequests")">
                    SHOW ALL REQUESTS
                </a>
            </div>
        }
    </section>
</div>
