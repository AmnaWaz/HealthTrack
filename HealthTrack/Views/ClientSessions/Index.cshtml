
@model HealthTrack.ViewModels.ClientSessionsViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Sessions";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<style>
    .cs-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 28px 14px 70px;
    }

    .cs-eyebrow {
        display: block;
        color: #b6505d;
        font: 600 11px "IBM Plex Mono", monospace;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .cs-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

        .cs-heading h1 {
            margin: 8px 0;
            font: 700 clamp(40px, 5vw, 68px) "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cs-muted {
        color: #858d99;
        font-size: 13px;
    }

    .cs-button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 12px 18px;
        background: #b6505d;
        border: 1px solid #b6505d;
        color: #fff;
        font: 600 11px "IBM Plex Mono", monospace;
        text-decoration: none;
        text-transform: uppercase;
    }

        .cs-button:hover {
            background: #933e49;
            color: #fff;
        }

    .cs-button-disabled {
        background: transparent;
        border-color: #a5aab2;
        color: #858d99;
        cursor: not-allowed;
    }

    .cs-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        border: 1px solid #bfc1c5;
        background: #bfc1c5;
        margin-bottom: 35px;
    }

    .cs-stat {
        padding: 23px;
        background: var(--ht-surface, #f4f0e8);
    }

        .cs-stat span {
            display: block;
            color: #858d99;
            font: 600 10px "IBM Plex Mono", monospace;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .cs-stat strong {
            font: 700 36px "Archivo Narrow", sans-serif;
        }

    .cs-section {
        margin-top: 38px;
    }

    .cs-section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

        .cs-section-head h2 {
            margin: 7px 0 0;
            font: 700 28px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cs-panel {
        padding: 23px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
    }

    .cs-trainer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .cs-trainer-row h3 {
            margin: 6px 0;
            font: 700 25px "Archivo Narrow", sans-serif;
        }

    .cs-list {
        display: grid;
        gap: 12px;
    }

    .cs-appointment {
        display: grid;
        grid-template-columns: 86px minmax(0, 1fr) auto;
        align-items: start;
        gap: 20px;
        padding: 22px;
        border: 1px solid var(--ht-border, #b9bdc2);
        background: var(--ht-surface, #f4f0e8);
    }

    .cs-date {
        border-right: 1px solid var(--ht-border, #b9bdc2);
        padding-right: 16px;
        text-align: center;
    }

        .cs-date strong {
            display: block;
            font: 700 34px "Archivo Narrow", sans-serif;
        }

        .cs-date span {
            display: block;
            font: 600 11px "IBM Plex Mono", monospace;
            color: #858d99;
            text-transform: uppercase;
        }

    .cs-appointment h3 {
        margin: 0 0 8px;
        font: 700 23px "Archivo Narrow", sans-serif;
    }

    .cs-appointment p {
        margin: 5px 0;
        font-size: 13px;
        line-height: 1.7;
    }

    .cs-notes {
        margin-top: 14px;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .cs-status {
        display: inline-flex;
        padding: 7px 10px;
        border: 1px solid #aab0b9;
        color: inherit;
        font: 600 10px "IBM Plex Mono", monospace;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cs-status-pending {
        border-color: #bc9766;
        color: #bc9766;
    }

    .cs-status-confirmed {
        border-color: #65967c;
        color: #65967c;
    }

    .cs-status-cancelled {
        border-color: #b6505d;
        color: #b6505d;
    }

    .cs-empty {
        padding: 35px 20px;
        text-align: center;
        border: 1px dashed #aab0b9;
    }

        .cs-empty h3 {
            margin: 0 0 10px;
            font: 700 22px "Archivo Narrow", sans-serif;
            text-transform: uppercase;
        }

    .cs-request-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: center;
    }

        .cs-request-panel h3 {
            font: 700 27px "Archivo Narrow", sans-serif;
            margin: 8px 0;
            text-transform: uppercase;
        }

    @@media (max-width: 760px) {
        .cs-heading {
            flex-direction: column;
            align-items: stretch;
        }

        .cs-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cs-appointment {
            grid-template-columns: 66px minmax(0, 1fr);
        }

            .cs-appointment .cs-status {
                grid-column: 2;
                width: fit-content;
            }

        .cs-request-panel {
            grid-template-columns: 1fr;
        }
    }
    .cs-booking-form { display:grid; gap:10px; min-width:240px; width:100%; max-width:460px; }
    .cs-booking-form input, .cs-booking-form textarea { box-sizing:border-box; width:100%; padding:11px; border:1px solid #83919d; border-radius:3px; background:transparent; color:inherit; font:inherit; }
    .cs-booking-form label { font-size:12px; font-weight:600; }
</style>

<div class="cs-page">
    <header class="cs-heading">
        <div>
            <span class="cs-eyebrow">05 / CLIENT WORKSPACE</span>
            <h1>YOUR SESSIONS</h1>
            <p class="cs-muted">
                Your consultations, upcoming appointments and session history.
            </p>
        </div>

        <a class="cs-button" href="#csRequestSection">
            REQUEST A SESSION
        </a>
    </header>

    <div class="cs-stats">
        <div class="cs-stat">
            <span>Upcoming</span>
            <strong>@Model.UpcomingCount</strong>
        </div>

        <div class="cs-stat">
            <span>Pending</span>
            <strong>@Model.PendingCount</strong>
        </div>

        <div class="cs-stat">
            <span>Completed</span>
            <strong>@Model.CompletedCount</strong>
        </div>

        <div class="cs-stat">
            <span>Cancelled / Declined</span>
            <strong>@Model.CancelledCount</strong>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <p role="status" style="padding:12px;border:1px solid currentColor">@TempData["Success"]</p>
    }
    @if (TempData["Error"] != null)
    {
        <p role="alert" style="padding:12px;border:1px solid currentColor">@TempData["Error"]</p>
    }
    <section class="cs-section">
        <div class="cs-section-head">
            <div>
                <span class="cs-eyebrow">01 / YOUR TRAINER</span>
                <h2>SESSION COORDINATION</h2>
            </div>
        </div>

        <div class="cs-panel cs-trainer-row">
            <div>
                @if (Model.HasAssignedTrainer)
                {
                    <span class="cs-eyebrow">ASSIGNED TRAINER</span>
                    <h3>@(string.IsNullOrWhiteSpace(Model.TrainerName) ? "Trainer assigned" : Model.TrainerName)</h3>
                    <p class="cs-muted">
                        Your assigned trainer manages appointment approvals and updates.
                    </p>
                }
                else
                {
                    <span class="cs-eyebrow">TRAINER ASSIGNMENT</span>
                    <h3>NO TRAINER ASSIGNED</h3>
                    <p class="cs-muted">
                        Appointments can be requested once you have an assigned trainer.
                    </p>
                }
            </div>
        </div>
    </section>

    <section class="cs-section">
        <div class="cs-section-head">
            <div>
                <span class="cs-eyebrow">02 / CONFIRMED</span>
                <h2>UPCOMING SESSIONS</h2>
            </div>
            <span class="cs-muted">@Model.UpcomingAppointments.Count appointments</span>
        </div>

        @if (Model.UpcomingAppointments.Any())
        {
            <div class="cs-list">
                @foreach (var appointment in Model.UpcomingAppointments)
                {
                    <article class="cs-appointment">
                        <div class="cs-date">
                            <strong>@appointment.AppointmentDateTime.ToString("dd")</strong>
                            <span>@appointment.AppointmentDateTime.ToString("MMM yyyy")</span>
                        </div>

                        <div>
                            <h3>TRAINING CONSULTATION</h3>
                            <p><strong>Trainer:</strong> @appointment.TrainerName</p>
                            <p><strong>Time:</strong> @appointment.AppointmentDateTime.ToString("dddd, hh:mm tt")</p>

                            @if (!string.IsNullOrWhiteSpace(appointment.Location))
                            {
                                <p><strong>Location:</strong> @appointment.Location</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                            {
                                <details class="cs-notes">
                                    <summary>Appointment notes</summary>
                                    <p>@appointment.Notes</p>
                                </details>
                            }
                        </div>

                        <span class="cs-status cs-status-confirmed">
                            @appointment.Status
                        </span>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="cs-empty">
                <h3>NO UPCOMING APPOINTMENTS</h3>
                <p class="cs-muted">Confirmed sessions will appear here.</p>
            </div>
        }
    </section>

    <section class="cs-section">
        <div class="cs-section-head">
            <div>
                <span class="cs-eyebrow">03 / REQUESTS</span>
                <h2>PENDING APPOINTMENTS</h2>
            </div>
            <span class="cs-muted">@Model.PendingAppointments.Count pending</span>
        </div>

        @if (Model.PendingAppointments.Any())
        {
            <div class="cs-list">
                @foreach (var appointment in Model.PendingAppointments)
                {
                    <article class="cs-appointment">
                        <div class="cs-date">
                            <strong>@appointment.AppointmentDateTime.ToString("dd")</strong>
                            <span>@appointment.AppointmentDateTime.ToString("MMM yyyy")</span>
                        </div>

                        <div>
                            <h3>APPOINTMENT REQUEST</h3>
                            <p><strong>Trainer:</strong> @appointment.TrainerName</p>
                            <p><strong>Requested:</strong> @appointment.AppointmentDateTime.ToString("dddd, hh:mm tt")</p>

                            @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                            {
                                <details class="cs-notes">
                                    <summary>Request notes</summary>
                                    <p>@appointment.Notes</p>
                                </details>
                            }

                            <p class="cs-muted">
                                Awaiting trainer confirmation.
                            </p>
                        </div>

                        <div>
                            <span class="cs-status cs-status-pending">PENDING</span>
                            @if (appointment.CanWithdraw)
                            {
                                using (Html.BeginForm("Withdraw", "ClientSessions", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                    <button type="submit" class="cs-button">WITHDRAW REQUEST</button>
                                }
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="cs-empty">
                <h3>NO PENDING REQUESTS</h3>
                <p class="cs-muted">Appointment requests awaiting approval will appear here.</p>
            </div>
        }
    </section>

    <section class="cs-section">
        <div class="cs-section-head">
            <div>
                <span class="cs-eyebrow">04 / PREVIOUS ACTIVITY</span>
                <h2>SESSION HISTORY</h2>
            </div>
            <span class="cs-muted">@Model.AppointmentHistory.Count records</span>
        </div>

        @if (Model.AppointmentHistory.Any())
        {
            <div class="cs-list">
                @foreach (var appointment in Model.AppointmentHistory)
                {
                    var statusClass =
                        appointment.Status == "Cancelled" ||
                        appointment.Status == "Declined" ||
                        appointment.Status == "Rejected"
                            ? "cs-status-cancelled"
                            : "cs-status-confirmed";

                    <article class="cs-appointment">
                        <div class="cs-date">
                            <strong>@appointment.AppointmentDateTime.ToString("dd")</strong>
                            <span>@appointment.AppointmentDateTime.ToString("MMM yyyy")</span>
                        </div>

                        <div>
                            <h3>CONSULTATION</h3>
                            <p><strong>Trainer:</strong> @appointment.TrainerName</p>
                            <p><strong>Date:</strong> @appointment.AppointmentDateTime.ToString("dddd, dd MMM yyyy")</p>
                            <p><strong>Time:</strong> @appointment.AppointmentDateTime.ToString("hh:mm tt")</p>

                            @if (!string.IsNullOrWhiteSpace(appointment.Location))
                            {
                                <p><strong>Location:</strong> @appointment.Location</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                            {
                                <details class="cs-notes">
                                    <summary>View notes</summary>
                                    <p>@appointment.Notes</p>
                                </details>
                            }
                        </div>

                        <span class="cs-status @statusClass">
                            @appointment.Status
                        </span>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="cs-empty">
                <h3>NO SESSION HISTORY</h3>
                <p class="cs-muted">Your past appointments will appear here.</p>
            </div>
        }
    </section>

    <section class="cs-section" id="csRequestSection">
        <div class="cs-section-head">
            <div>
                <span class="cs-eyebrow">05 / NEW APPOINTMENT</span>
                <h2>REQUEST A SESSION</h2>
            </div>
        </div>

        <div class="cs-panel cs-request-panel">
            <div>
                <h3>
                    @(Model.HasAssignedTrainer ? "PLAN YOUR NEXT CONSULTATION" : "TRAINER REQUIRED")
                </h3>

                @if (Model.HasAssignedTrainer)
                {
                    <p class="cs-muted">Choose a date and time. Your trainer will review your request.</p>
                }
                else
                {
                    <p class="cs-muted">Your trainer must be assigned before you can request a session.</p>
                }
            </div>
            @if (Model.HasAssignedTrainer)
            {
                using (Html.BeginForm("RequestAppointment", "ClientSessions", FormMethod.Post, new { @class = "cs-booking-form" }))
                {
                    @Html.AntiForgeryToken()
                    <label for="RequestForm_Date">Preferred date</label>
                    <input id="RequestForm_Date" name="Date" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <label for="RequestForm_Time">Preferred time</label>
                    <input id="RequestForm_Time" name="Time" type="time" required />
                    <label for="RequestForm_Notes">Notes (optional)</label>
                    <textarea id="RequestForm_Notes" name="Notes" maxlength="500" rows="3"></textarea>
                    <button class="cs-button" type="submit">SEND REQUEST</button>
                }
            }
        </div>
    </section>
</div>

<div style="max-width:1000px;margin:24px auto;padding:0 20px"><a href="@Url.Action("Index", "HealthcareAppointments")">Track healthcare consultations →</a></div>
